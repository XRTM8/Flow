import { Theme } from "theme.slint";
import { HistoryItem } from "models.slint";
import { ScrollView } from "std-widgets.slint";

export component DesktopApp inherits Window {
    title: "Otium Flow";
    min-width: 780px;
    min-height: 520px;
    preferred-width: 840px;
    preferred-height: 560px;
    background: Theme.background;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";

    in-out property <string> peer_name: "Scanning Wi-Fi...";
    in-out property <bool> is_connected: false;
    in-out property <string> clipboard_text: "No clipboard synced yet";
    in-out property <bool> clipboard_cleaned: false;
    in-out property <bool> transfer_active: false;
    in-out property <string> transfer_name: "";
    in-out property <float> transfer_progress: 0.0;
    in-out property <string> transfer_status: "";
    in-out property <bool> show_history: false;
    in-out property <[HistoryItem]> history_items: [];
    in-out property <bool> clipboard_copied: false;
    in-out property <bool> clipboard_pushed: false;
    in-out property <string> sas_code: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_in_progress: false;

    callback copy_clipboard_clicked();
    callback send_clipboard_clicked();
    callback send_file_clicked();
    callback open_downloads_clicked();
    callback toggle_history();
    callback clear_history();
    callback cancel_transfer_clicked();
    callback apply_update_clicked();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // 1. الشريط العلوي العام (Top Navigation Bar)
        HorizontalLayout {
            alignment: space-between;
            height: 36px;

            // شعار FLOW الأنيق
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                Text {
                    text: "FLOW";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    letter-spacing: 2px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 1px;
                    height: 14px;
                    background: Theme.border;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "by Otium";
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }

            // أدوات الحالة وتحديث البرنامج
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                if root.update_available : Rectangle {
                    background: update-touch.pressed ? #3b82f644 : update-touch.has-hover ? #3b82f628 : #3b82f618;
                    border-width: 1px;
                    border-color: #3b82f655;
                    border-radius: 14px;
                    height: 28px;
                    animate background { duration: 120ms; }
                    update-touch := TouchArea {
                        clicked => { root.apply_update_clicked(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: root.update_in_progress ? "Updating..." : "Update " + root.update_version;
                            font-size: 11px;
                            font-weight: 600;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }

                // كبسولة حالة الاتصال الأنيقة
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 14px;
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.is_connected ? Theme.status-online : Theme.status-waiting;
                            border-width: 1px;
                            border-color: root.is_connected ? #10b98144 : #f59e0b44;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.peer_name;
                            font-size: 12px;
                            font-weight: 500;
                            color: root.is_connected ? Theme.text-secondary : Theme.text-muted;
                            vertical-alignment: center;
                        }

                        if root.is_connected && root.sas_code != "" : Rectangle {
                            background: Theme.recessed;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "#" + root.sas_code + " Verified";
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 2. الهيكل الرئيسي للشاشة المكتبية (Desktop 2-Column Responsive Layout)
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            // ===== العمود الأيسر: إدارة الاتصال وإرسال الملفات =====
            VerticalLayout {
                width: 380px;
                spacing: 12px;

                // بطاقة الجهاز المتصل
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? Theme.accent : Theme.border;
                    border-radius: Theme.radius-md;
                    height: 84px;
                    animate border-color { duration: 150ms; }

                    HorizontalLayout {
                        padding: 14px;
                        spacing: 14px;
                        alignment: center;

                        // أيقونة الجهاز الذكي
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: 10px;
                            background: root.is_connected ? Theme.accent-glow : Theme.recessed;
                            border-width: 1px;
                            border-color: root.is_connected ? Theme.accent : Theme.border-subtle;
                            y: (parent.height - self.height) / 2;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Rectangle {
                                    width: 18px;
                                    height: 26px;
                                    border-radius: 4px;
                                    border-width: 1.5px;
                                    border-color: root.is_connected ? Theme.accent : Theme.text-muted;
                                    x: (parent.width - self.width) / 2;
                                    // شاشة الهاتف الصغيرة
                                    Rectangle {
                                        width: 12px;
                                        height: 16px;
                                        y: 3px;
                                        x: (parent.width - self.width) / 2;
                                        background: root.is_connected ? #10b98133 : #ffffff10;
                                        border-radius: 1px;
                                    }
                                }
                            }
                        }

                        // تفاصيل الجهاز والاتصال
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.peer_name;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: root.is_connected ? "Connected via Zero-Config Local Wi-Fi" : "Waiting for phone on the same Wi-Fi network...";
                                font-size: 11px;
                                color: root.is_connected ? Theme.accent : Theme.text-muted;
                            }
                        }
                    }
                }

                // مساحة السحب والإفلات وإرسال الملفات (Dropzone)
                drop-area := Rectangle {
                    background: drop-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1.5px;
                    border-color: drop-touch.has-hover ? Theme.accent : Theme.border;
                    border-radius: Theme.radius-md;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }
                    vertical-stretch: 1;

                    drop-touch := TouchArea {
                        clicked => { root.send_file_clicked(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 14px;
                        padding: 20px;

                        // أيقونة الرفع الدائرية
                        Rectangle {
                            width: 52px;
                            height: 52px;
                            border-radius: 26px;
                            background: drop-touch.has-hover ? Theme.accent-glow : Theme.recessed;
                            border-width: 1px;
                            border-color: drop-touch.has-hover ? Theme.accent : Theme.border;
                            animate background { duration: 150ms; }
                            animate border-color { duration: 150ms; }
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                Rectangle {
                                    width: 2px;
                                    height: 14px;
                                    background: drop-touch.has-hover ? Theme.accent : Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                }
                                Rectangle {
                                    width: 10px;
                                    height: 2px;
                                    background: drop-touch.has-hover ? Theme.accent : Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Drop files or folders here";
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Ultra-fast encrypted local Wi-Fi transfer";
                                font-size: 11px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // زر استعراض الملفات الأساسي
                        Rectangle {
                            width: 150px;
                            height: 34px;
                            border-radius: 6px;
                            background: drop-touch.has-hover ? Theme.accent-hover : Theme.accent;
                            x: (parent.width - self.width) / 2;
                            animate background { duration: 120ms; }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "Browse Files";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // زر فتح مجلد التنزيلات
                Rectangle {
                    background: rec-files-touch.pressed ? Theme.surface-pressed : rec-files-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;
                    height: 38px;
                    animate background { duration: 120ms; }

                    rec-files-touch := TouchArea {
                        clicked => { root.open_downloads_clicked(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "Open Received Files Folder";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ===== العمود الأيمن: الحافظة التزامنية وسجل النشاط =====
            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;

                // بطاقة الحافظة اللحظية (Live Synced Clipboard)
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 170px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "LIVE CLIPBOARD";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-muted;
                                letter-spacing: 1px;
                            }

                            if root.clipboard_cleaned : Rectangle {
                                background: #10b98115;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #10b98133;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Cleaned";
                                        font-size: 9px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // صندوق محتوى الحافظة
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            Text {
                                text: root.clipboard_text;
                                font-size: 13px;
                                color: root.clipboard_text == "No clipboard synced yet" ? Theme.text-faint : Theme.text-primary;
                                wrap: word-wrap;
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                height: parent.height - 20px;
                            }
                        }

                        // أزرار التحكم بالحافظة
                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;

                            Rectangle {
                                background: copy-touch.pressed ? Theme.surface-pressed : copy-touch.has-hover ? Theme.surface-hover : #00000000;
                                border-width: 1px;
                                border-color: copy-touch.has-hover ? Theme.border : Theme.border-subtle;
                                border-radius: 6px;
                                height: 26px;
                                animate background { duration: 120ms; }
                                copy-touch := TouchArea {
                                    clicked => { root.copy_clipboard_clicked(); }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.clipboard_copied ? "Copied" : "Copy";
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: root.clipboard_copied ? Theme.accent : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: send-clip-touch.pressed ? #10b98126 : send-clip-touch.has-hover ? #10b98114 : #00000000;
                                border-width: 1px;
                                border-color: send-clip-touch.has-hover ? #10b98144 : Theme.border-subtle;
                                border-radius: 6px;
                                height: 26px;
                                animate background { duration: 120ms; }
                                send-clip-touch := TouchArea {
                                    clicked => { root.send_clipboard_clicked(); }
                                }
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.clipboard_pushed ? "Sent" : "Push to Phone";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // بطاقة النقل المباشر (Active Transfer Card)
                if root.transfer_active : Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;
                    height: 56px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.transfer_name;
                                font-size: 12px;
                                font-weight: 500;
                                color: Theme.text-primary;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    background: Theme.recessed;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    height: 20px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: root.transfer_status;
                                            font-size: 10px;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 24px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: cancel-touch.pressed ? #ef444433 : cancel-touch.has-hover ? #ef444422 : #00000000;
                                    animate background { duration: 120ms; }
                                    cancel-touch := TouchArea {
                                        clicked => { root.cancel_transfer_clicked(); }
                                    }
                                    Text {
                                        text: "x";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.status-error;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.recessed;

                            Rectangle {
                                x: 0;
                                y: 0;
                                height: parent.height;
                                width: parent.width * root.transfer_progress;
                                border-radius: 2px;
                                background: Theme.accent;
                                animate width { duration: 100ms; easing: ease-out; }
                            }
                        }
                    }
                }

                // بطاقة سجل النشاطات الأخير (Activity History Panel)
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ACTIVITY HISTORY";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.text-muted;
                                letter-spacing: 1px;
                            }

                            if root.history_items.length > 0 : Rectangle {
                                background: clear-touch.pressed ? Theme.surface-pressed : clear-touch.has-hover ? Theme.surface-hover : #00000000;
                                border-radius: 4px;
                                height: 20px;
                                clear-touch := TouchArea {
                                    clicked => { root.clear_history(); }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Clear";
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.history_items.length == 0 : VerticalLayout {
                            alignment: center;
                            vertical-stretch: 1;
                            Text {
                                text: "No transfers yet in this session";
                                font-size: 12px;
                                color: Theme.text-faint;
                                horizontal-alignment: center;
                            }
                        }

                        if root.history_items.length > 0 : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.history_items : Rectangle {
                                    background: Theme.recessed;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    height: 44px;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        alignment: center;

                                        Rectangle {
                                            width: 26px;
                                            height: 26px;
                                            border-radius: 6px;
                                            background: item.kind == "file" ? #10b98118 : #3b82f618;
                                            border-width: 1px;
                                            border-color: item.kind == "file" ? #10b98133 : #3b82f633;
                                            y: (parent.height - self.height) / 2;

                                            Text {
                                                text: item.kind == "file" ? "F" : "C";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: item.kind == "file" ? Theme.accent : #60a5fa;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: item.title;
                                                font-size: 12px;
                                                font-weight: 500;
                                                color: Theme.text-primary;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: item.subtitle;
                                                font-size: 10px;
                                                color: Theme.text-muted;
                                            }
                                        }

                                        Text {
                                            text: item.timestamp;
                                            font-size: 10px;
                                            color: Theme.text-muted;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
