import { Theme } from "theme.slint";
import { HistoryItem } from "models.slint";
import { ScrollView } from "std-widgets.slint";

export component DesktopApp inherits Window {
    title: "Otium Flow";
    min-width: 740px;
    min-height: 560px;
    preferred-width: 820px;
    preferred-height: 600px;
    background: Theme.background;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";

    in-out property <int> active_tab_index: 0; // 0: STREAM, 1: FILES, 2: MESH, 3: ACTIVITY
    in-out property <bool> show_history: false;
    in-out property <string> peer_name: "Scanning Wi-Fi...";
    in-out property <bool> is_connected: false;
    in-out property <string> clipboard_text: "No clipboard synced yet";
    in-out property <bool> clipboard_cleaned: false;
    in-out property <bool> transfer_active: false;
    in-out property <string> transfer_name: "";
    in-out property <float> transfer_progress: 0.0;
    in-out property <string> transfer_status: "";
    in-out property <[HistoryItem]> history_items: [];
    in-out property <bool> clipboard_copied: false;
    in-out property <bool> clipboard_pushed: false;
    in-out property <string> sas_code: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_in_progress: false;
    in-out property <string> draft_text: "";
    in-out property <bool> text_sent: false;
    in-out property <string> lang: "EN"; // "EN" or "AR"

    callback copy_clipboard_clicked();
    callback send_clipboard_clicked();
    callback send_file_clicked();
    callback open_downloads_clicked();
    callback toggle_history();
    callback clear_history();
    callback cancel_transfer_clicked();
    callback apply_update_clicked();
    callback send_custom_text(string);
    callback paste_to_draft();
    callback clear_draft();

    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "1") {
                root.active_tab_index = 0;
                return accept;
            }
            if (event.modifiers.control && event.text == "2") {
                root.active_tab_index = 1;
                return accept;
            }
            if (event.modifiers.control && event.text == "3") {
                root.active_tab_index = 2;
                return accept;
            }
            if (event.modifiers.control && event.text == "4") {
                root.active_tab_index = 3;
                return accept;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O")) {
                root.send_file_clicked();
                return accept;
            }
            if (event.modifiers.control && event.text == "\n") {
                root.send_custom_text(root.draft_text);
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;

        // 1. الشريط العلوي الشامل (Raycast Omnibar Header)
        HorizontalLayout {
            alignment: space-between;
            height: 40px;

            // شعار الهوية النقي
            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: #111726;
                    border-width: 1px;
                    border-color: Theme.accent-glow;

                    // علامة هندسية متجهة نقية
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 3px;
                        background: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "FLOW";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-primary;
                        letter-spacing: 2.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 12px;
                        background: Theme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "OTIUM";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }
            }

            // أدوات الحالة وتحديث البرنامج والتحقق الأمني
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                if root.update_available : Rectangle {
                    background: update-btn.pressed ? #3b82f644 : update-btn.has-hover ? #3b82f628 : #3b82f618;
                    border-width: 1px;
                    border-color: #3b82f666;
                    border-radius: Theme.radius-sm;
                    height: 30px;
                    animate background { duration: 120ms; }
                    update-btn := TouchArea {
                        clicked => { root.apply_update_clicked(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        Text {
                            text: root.update_in_progress ? "UPDATING..." : "UPDATE " + root.update_version;
                            font-size: 10px;
                            font-weight: 700;
                            color: #60a5fa;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }

                // كبسولة الاتصال بالأجهزة
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? Theme.accent-glow : Theme.border;
                    border-radius: Theme.radius-sm;
                    height: 30px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: root.is_connected ? Theme.status-online : Theme.status-waiting;
                            border-width: 1px;
                            border-color: root.is_connected ? #00d2ff88 : #f59e0b88;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.peer_name;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.is_connected ? Theme.text-primary : Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        if root.is_connected && root.sas_code != "" : Rectangle {
                            background: #00d2ff18;
                            border-radius: 4px;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "#" + root.sas_code + " VERIFIED";
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: Theme.accent;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 2. بطاقة تتبع النقل اللحظي (HUD Transfer Telemetry)
        if root.transfer_active : Rectangle {
            background: #0b111c;
            border-width: 1px;
            border-color: Theme.accent;
            border-radius: Theme.radius-sm;
            height: 56px;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 5px;
                            background: #00d2ff22;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: root.transfer_name;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                text: root.transfer_status;
                                font-size: 10px;
                                color: Theme.accent;
                                font-weight: 600;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: Math.round(root.transfer_progress * 100) + "%";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 24px;
                            height: 22px;
                            border-radius: 5px;
                            background: cancel-desk-btn.pressed ? #f43f5e44 : #1c263c;
                            border-width: 1px;
                            border-color: #f43f5e55;
                            cancel-desk-btn := TouchArea {
                                clicked => { root.cancel_transfer_clicked(); }
                            }
                            // علامة إغلاق هندسية نقية
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 1.5px;
                                    background: Theme.status-error;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: #04060a;

                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width * root.transfer_progress;
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 100ms; easing: ease-out; }
                    }
                }
            }
        }

        // 3. مساحة العمل الرئيسية مع استيعاب كامل ومساحات تنفس رحبة
        VerticalLayout {
            vertical-stretch: 1;

            // ================== الواجهة 0: البث والملاحظات المباشرة (STREAM) ==================
            if root.active_tab_index == 0 : VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;

                // محرر الملاحظات والنصوص المباشر (Omnibar Text Composer)
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: omni-input.has-focus ? Theme.border-focus : Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;
                    animate border-color { duration: 120ms; }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: "DIRECT NOTE & MESSAGE BEAM";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    letter-spacing: 1.2px;
                                }
                                Rectangle {
                                    background: #00d2ff18;
                                    border-radius: 4px;
                                    height: 18px;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: "Zero-Latency Stream";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Rectangle {
                                    background: p-desk-touch.pressed ? #1c263c : p-desk-touch.has-hover ? #172033 : #0c121e;
                                    border-width: 1px;
                                    border-color: p-desk-touch.has-hover ? Theme.border-focus : Theme.border;
                                    border-radius: 6px;
                                    height: 26px;
                                    p-desk-touch := TouchArea {
                                        clicked => { root.paste_to_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: "Paste Clipboard";
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.draft_text != "" : Rectangle {
                                    background: clr-desk-touch.pressed ? #f43f5e33 : #0c121e;
                                    border-width: 1px;
                                    border-color: #f43f5e55;
                                    border-radius: 6px;
                                    height: 26px;
                                    clr-desk-touch := TouchArea {
                                        clicked => { root.clear_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Clear";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.status-error;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // صندوق النص
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: omni-input.has-focus ? #00d2ff66 : Theme.border-subtle;
                            vertical-stretch: 1;

                            if root.draft_text == "" : Text {
                                text: "Type any note, message, link, code snippet or command to beam directly to phone...";
                                font-size: 13px;
                                color: Theme.text-faint;
                                wrap: word-wrap;
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                            }

                            omni-input := TextInput {
                                text <=> root.draft_text;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 13px;
                                color: Theme.text-primary;
                                selection-background-color: #00d2ff44;
                                selection-foreground-color: #ffffff;
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                height: parent.height - 20px;
                            }
                        }

                        // شريط الإجراء السفلي للمحرر
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: root.draft_text != "" ? "Text ready to stream" : "Direct stream buffer";
                                    font-size: 11px;
                                    color: root.draft_text != "" ? Theme.accent : Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: beam-now-touch.pressed ? #0284c7 : beam-now-touch.has-hover ? #0369a1 : #0284c7;
                                border-width: 1px;
                                border-color: Theme.accent;
                                border-radius: Theme.radius-sm;
                                height: 34px;
                                animate background { duration: 120ms; }

                                beam-now-touch := TouchArea {
                                    clicked => { root.send_custom_text(root.draft_text); }
                                }

                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: root.text_sent ? "SENT TO PEER" : "BEAM TO PEER";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        letter-spacing: 1px;
                                        vertical-alignment: center;
                                    }

                                    // Keycap هندسي
                                    Rectangle {
                                        background: #ffffff22;
                                        border-radius: 4px;
                                        height: 18px;
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            Text {
                                                text: "RETURN";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // بطاقة استعراض الحافظة المستلمة
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 120px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "RECEIVED CLIPBOARD FROM PEER";
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                letter-spacing: 1px;
                            }

                            Rectangle {
                                background: copy-clip-btn.pressed ? #1c263c : #0c121e;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 5px;
                                height: 24px;
                                copy-clip-btn := TouchArea {
                                    clicked => { root.copy_clipboard_clicked(); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.clipboard_copied ? "COPIED" : "COPY TO PC";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: root.clipboard_copied ? Theme.accent : Theme.text-secondary;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            Text {
                                text: root.clipboard_text;
                                font-size: 12px;
                                color: root.clipboard_text == "No clipboard synced yet" ? Theme.text-faint : Theme.text-primary;
                                wrap: word-wrap;
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                            }
                        }
                    }
                }
            }

            // ================== الواجهة 1: نقل وإسقاط الملفات (FILES) ==================
            if root.active_tab_index == 1 : VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;

                drop-area-desk := Rectangle {
                    background: drop-desk-touch.has-hover ? #131a29 : Theme.surface;
                    border-width: 1.5px;
                    border-color: drop-desk-touch.has-hover ? Theme.accent : Theme.border;
                    border-radius: Theme.radius-md;
                    animate background { duration: 150ms; }
                    animate border-color { duration: 150ms; }
                    vertical-stretch: 1;

                    drop-desk-touch := TouchArea {
                        clicked => { root.send_file_clicked(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;
                        padding: 24px;

                        // مؤشر دائري هندسي نقي
                        Rectangle {
                            width: 68px;
                            height: 68px;
                            border-radius: 34px;
                            background: drop-desk-touch.has-hover ? #00d2ff22 : #0a0f18;
                            border-width: 1px;
                            border-color: drop-desk-touch.has-hover ? Theme.accent : Theme.border;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Rectangle {
                                    width: 2px;
                                    height: 18px;
                                    background: drop-desk-touch.has-hover ? Theme.accent : Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                }
                                Rectangle {
                                    width: 14px;
                                    height: 2px;
                                    background: drop-desk-touch.has-hover ? Theme.accent : Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Drop files or folders here";
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Direct hardware-accelerated local Wi-Fi transfer at 100+ MB/s";
                                font-size: 12px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // زر تصفح الملفات
                        Rectangle {
                            width: 170px;
                            height: 38px;
                            border-radius: Theme.radius-sm;
                            background: drop-desk-touch.has-hover ? #0284c7 : #0369a1;
                            border-width: 1px;
                            border-color: Theme.accent;
                            x: (parent.width - self.width) / 2;

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "BROWSE FILES";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // زر فتح مجلد التنزيلات
                Rectangle {
                    background: open-dl-btn.pressed ? Theme.surface-pressed : open-dl-btn.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;
                    height: 42px;

                    open-dl-btn := TouchArea {
                        clicked => { root.open_downloads_clicked(); }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "OPEN RECEIVED FILES DIRECTORY";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-secondary;
                            letter-spacing: 1px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ================== الواجهة 2: الشبكة والجهاز المتصل (MESH) ==================
            if root.active_tab_index == 2 : VerticalLayout {
                spacing: 14px;
                vertical-stretch: 1;

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? #00d2ff44 : Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 20px;
                        alignment: center;

                        // أيقونة الجهاز الهندسية الدقيقة
                        Rectangle {
                            width: 72px;
                            height: 72px;
                            border-radius: 18px;
                            background: root.is_connected ? #00d2ff18 : Theme.recessed;
                            border-width: 1.5px;
                            border-color: root.is_connected ? Theme.accent : Theme.border-subtle;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 38px;
                                    border-radius: 5px;
                                    border-width: 2px;
                                    border-color: root.is_connected ? Theme.accent : Theme.text-muted;
                                    x: (parent.width - self.width) / 2;

                                    Rectangle {
                                        width: 14px;
                                        height: 24px;
                                        y: 4px;
                                        x: (parent.width - self.width) / 2;
                                        background: root.is_connected ? #00d2ff33 : #ffffff10;
                                        border-radius: 2px;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.peer_name;
                                font-size: 18px;
                                font-weight: 800;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.is_connected ? "Direct Zero-Hop P2P Connection Active" : "Searching local Wi-Fi subnet for peers...";
                                font-size: 12px;
                                color: root.is_connected ? Theme.accent : Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // بطاقة المواصفات التشفيرية
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            width: 380px;
                            height: 90px;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "ENCRYPTION CIPHER";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.text-muted;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: "ChaCha20-Poly1305 E2EE";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "SECURITY CODE";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.text-muted;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: root.sas_code != "" ? "#" + root.sas_code + " (Pairwise Verified)" : "Establishing Session...";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================== الواجهة 3: سجل النشاطات (ACTIVITY) ==================
            if root.active_tab_index == 3 : Rectangle {
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-md;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "ACTIVITY HISTORY";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            letter-spacing: 1.2px;
                        }

                        if root.history_items.length > 0 : Rectangle {
                            background: clr-all-btn.pressed ? #f43f5e33 : #0c121e;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #f43f5e55;
                            height: 24px;
                            clr-all-btn := TouchArea {
                                clicked => { root.clear_history(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "CLEAR";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.status-error;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.history_items.length == 0 : VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        spacing: 8px;
                        Text {
                            text: "No transfers yet in this session";
                            font-size: 13px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Beamed notes and sent files will appear here with verification tokens";
                            font-size: 11px;
                            color: Theme.text-faint;
                            horizontal-alignment: center;
                        }
                    }

                    if root.history_items.length > 0 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            for item in root.history_items : Rectangle {
                                background: Theme.recessed;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 46px;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;
                                    alignment: center;

                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: item.kind == "file" ? #00d2ff18 : #6366f118;
                                        border-width: 1px;
                                        border-color: item.kind == "file" ? #00d2ff44 : #6366f144;
                                        y: (parent.height - self.height) / 2;

                                        Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: item.kind == "file" ? Theme.accent : #818cf8;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: item.title;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subtitle;
                                            font-size: 10px;
                                            color: Theme.text-muted;
                                        }
                                    }

                                    Text {
                                        text: item.timestamp;
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. الدوك السفلي للتنقل الانسيابي بين الواجهات (Floating Raycast Bottom Dock)
        HorizontalLayout {
            alignment: center;
            height: 48px;

            Rectangle {
                background: #090e18f2;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 24px;
                height: 44px;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 6px;
                    alignment: center;

                    // Tab 0: STREAM
                    Rectangle {
                        background: root.active_tab_index == 0 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 0 ? 1px : 0px;
                        border-color: root.active_tab_index == 0 ? Theme.border-focus : #00000000;
                        border-radius: 18px;
                        animate background { duration: 150ms; }
                        t0-touch := TouchArea {
                            clicked => { root.active_tab_index = 0; }
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            Text {
                                text: "STREAM";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_tab_index == 0 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 1: FILES
                    Rectangle {
                        background: root.active_tab_index == 1 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 1 ? 1px : 0px;
                        border-color: root.active_tab_index == 1 ? Theme.border-focus : #00000000;
                        border-radius: 18px;
                        animate background { duration: 150ms; }
                        t1-touch := TouchArea {
                            clicked => { root.active_tab_index = 1; }
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            Text {
                                text: "FILES";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_tab_index == 1 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 2: MESH
                    Rectangle {
                        background: root.active_tab_index == 2 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 2 ? 1px : 0px;
                        border-color: root.active_tab_index == 2 ? Theme.border-focus : #00000000;
                        border-radius: 18px;
                        animate background { duration: 150ms; }
                        t2-touch := TouchArea {
                            clicked => { root.active_tab_index = 2; }
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            Text {
                                text: "MESH";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_tab_index == 2 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 3: ACTIVITY
                    Rectangle {
                        background: root.active_tab_index == 3 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 3 ? 1px : 0px;
                        border-color: root.active_tab_index == 3 ? Theme.border-focus : #00000000;
                        border-radius: 18px;
                        animate background { duration: 150ms; }
                        t3-touch := TouchArea {
                            clicked => { root.active_tab_index = 3; }
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            Text {
                                text: root.history_items.length > 0 ? "ACTIVITY (" + root.history_items.length + ")" : "ACTIVITY";
                                font-size: 11px;
                                font-weight: 700;
                                color: root.active_tab_index == 3 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1.2px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
}
