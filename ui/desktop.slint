import { ScrollView } from "std-widgets.slint";
import "../assets/fonts/NotoSansArabic.ttf";
import { AppState } from "state.slint";
import { Theme } from "theme.slint";
import { FlowRow, FlowButton, BodyText, SmallText, SectionTitle, Separator, Panel, TextField, DeviceRow, TransferRow, HistoryRow, SettingRow } from "components.slint";
import { PairingPane, FileBrowser } from "mobile.slint";

component RecipientBar inherits Panel {
    vertical-stretch: 0;
    recipient-content := VerticalLayout {
        padding: 16px; spacing: 8px;
        FlowRow {
            Image {
                source: AppState.is_connected ? @image-url("../assets/icons/monitor.svg") : @image-url("../assets/icons/wifi.svg");
                width: 23px; height: 23px; colorize: Theme.secondary;
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 2px;
                BodyText {
                    text: AppState.selected_peer_id == "" ? (AppState.rtl ? "اختر الجهاز المستلم" : "Choose a recipient") : AppState.peer_name;
                    font-weight: 600; overflow: elide; wrap: no-wrap;
                }
                SmallText {
                    text: AppState.connection_status;
                    color: AppState.connection_failed ? Theme.error : AppState.is_connected ? Theme.success : Theme.secondary;
                }
            }
            FlowButton {
                text: AppState.selected_peer_id == "" ? (AppState.rtl ? "الأجهزة" : "Devices") : (AppState.rtl ? "تغيير" : "Change");
                enabled: !AppState.busy;
                clicked => { AppState.show_devices = true; }
            }
        }
        if AppState.connection_failed && AppState.selected_peer_id != "" : FlowRow {
            FlowButton {
                text: AppState.rtl ? "إعادة المحاولة" : "Retry connection"; quiet: true;
                enabled: !AppState.connection_busy;
                clicked => { AppState.refresh_devices(); }
            }
            FlowButton { text: AppState.rtl ? "إصلاح الاقتران" : "Repair pairing"; quiet: true; clicked => { AppState.show_pairing = true; } }
        }
        if !AppState.is_connected && !AppState.connection_failed && !AppState.connection_busy && AppState.selected_peer_id != "" : FlowButton {
            text: AppState.rtl ? "إكمال الاقتران" : "Complete pairing"; quiet: true;
            clicked => { AppState.show_pairing = true; }
        }
    }
}

component SendPanel inherits Panel {
    preferred-width: 470px;
    vertical-stretch: 0;
    send-content := VerticalLayout {
        padding: 22px; spacing: 16px;
        FlowRow {
            Image { source: @image-url("../assets/icons/file-up.svg"); width: 24px; height: 24px; colorize: Theme.secondary; }
            SectionTitle { text: AppState.rtl ? "ملفات وصور" : "Files and photos"; horizontal-stretch: 1; }
        }
        SmallText {
            text: AppState.mobile_mode ? (AppState.rtl ? "اختر ما تريد إرساله من جهازك." : "Choose what to send from this device.") : (AppState.rtl ? "اسحب الملفات إلى النافذة، أو اخترها من جهازك." : "Drop files into this window, or choose them below.");
        }
        FlowButton {
            text: AppState.busy ? (AppState.rtl ? "الإرسال جارٍ" : "Sending files") : AppState.is_connected ? (AppState.rtl ? "اختيار ملفات" : "Choose files") : (AppState.rtl ? "اختيار الجهاز" : "Choose a device");
            icon: AppState.is_connected ? @image-url("../assets/icons/file-up.svg") : @image-url("../assets/icons/monitor.svg");
            primary: true; horizontal-stretch: 1; min-height: 48px;
            enabled: !AppState.busy;
            clicked => { if (AppState.is_connected) { AppState.send_files(); } else { AppState.show_devices = true; } }
        }
        Separator { }
        FlowRow {
            BodyText { text: AppState.rtl ? "نص أو رابط" : "Text or link"; font-weight: 600; horizontal-stretch: 1; }
            if AppState.draft_text != "" : FlowButton { text: AppState.rtl ? "مسح" : "Clear"; quiet: true; clicked => { AppState.draft_text = ""; } }
            FlowButton { text: AppState.rtl ? "لصق" : "Paste"; quiet: true; clicked => { AppState.paste_text(); } }
        }
        TextField {
            text <=> AppState.draft_text;
            label: AppState.rtl ? "النص المراد إرساله" : "Text to send";
            placeholder: AppState.rtl ? "اكتب نصًا أو الصق رابطًا…" : "Write a message or paste a link…";
            min-height: 112px;
        }
        FlowRow {
            SmallText {
                text: AppState.text_sent ? (AppState.rtl ? "تم الإرسال" : "Sent") : !AppState.is_connected ? (AppState.rtl ? "اختر جهازًا لإرسال النص." : "Choose a device to send.") : AppState.mobile_mode ? "" : "Ctrl + Enter";
                color: AppState.text_sent ? Theme.success : Theme.muted;
                horizontal-stretch: 1;
            }
            FlowButton {
                text: AppState.rtl ? "إرسال" : "Send";
                icon: @image-url("../assets/icons/send.svg");
                enabled: AppState.is_connected && AppState.draft_text != "" && !AppState.busy;
                clicked => { AppState.send_text(AppState.draft_text); }
            }
        }
    }
}

component ReceivedPanel inherits Panel {
    preferred-width: 290px;
    vertical-stretch: 0;
    received-content := VerticalLayout {
        padding: 20px; spacing: 14px;
        FlowRow {
            SectionTitle { text: AppState.rtl ? "المستلم" : "Received"; horizontal-stretch: 1; }
            FlowButton {
                text: AppState.rtl ? "الملفات" : "Files";
                icon: @image-url("../assets/icons/folder.svg"); quiet: true;
                clicked => { AppState.open_downloads(); }
            }
        }
        if AppState.clipboard_text == "" : SmallText {
            text: AppState.rtl ? "عند وصول نص، يمكنك قراءته ونسخه هنا." : "Received text will appear here, ready to copy.";
        }
        if AppState.clipboard_text != "" : TextField {
            text: AppState.clipboard_text; read_only: true;
            label: AppState.rtl ? "النص المستلم" : "Received text";
            min-height: 100px;
        }
        if AppState.clipboard_text != "" : FlowButton {
            text: AppState.clipboard_copied ? (AppState.rtl ? "تم النسخ" : "Copied") : (AppState.rtl ? "نسخ النص" : "Copy text");
            icon: @image-url("../assets/icons/copy.svg"); horizontal-stretch: 1;
            clicked => { AppState.copy_received(); }
        }
        if AppState.history_items.length > 0 : Separator { }
        if AppState.history_items.length > 0 : FlowRow {
            SmallText { text: AppState.rtl ? "آخر العمليات" : "Recent activity"; font-weight: 600; horizontal-stretch: 1; }
            FlowButton { text: AppState.rtl ? "الكل" : "All"; quiet: true; clicked => { AppState.show_history = true; } }
        }
        for index in min(3, AppState.history_items.length) : HistoryRow { item: AppState.history_items[index]; compact: true; }
    }
}

component HomePage inherits ScrollView {
    in property <bool> compact;
    VerticalLayout {
        padding: root.compact ? 16px : 24px; spacing: 18px;
        RecipientBar { }
        if AppState.transfers.length > 0 : Panel {
            VerticalLayout {
                padding-left: 18px; padding-right: 18px; padding-top: 14px; padding-bottom: 6px; spacing: 2px;
                SmallText { text: AppState.rtl ? "عمليات النقل" : "Transfers"; font-weight: 600; }
                for transfer in AppState.transfers : TransferRow { item: transfer; }
            }
        }
        FlexboxLayout {
            flex-direction: root.compact ? column : (AppState.rtl ? row-reverse : row);
            alignment: stretch; flex-wrap: no-wrap;
            spacing: 18px; cross-axis-alignment: start;
            SendPanel { horizontal-stretch: 2; }
            ReceivedPanel { horizontal-stretch: 1; }
        }
    }
}

component DevicePage inherits ScrollView {
    in property <bool> compact;
    VerticalLayout {
        padding: root.compact ? 16px : 24px; spacing: 18px;
        FlowRow {
            SectionTitle { text: AppState.rtl ? "الأجهزة القريبة" : "Nearby devices"; horizontal-stretch: 1; font-size: 21px; }
            FlowButton { text: AppState.rtl ? "تحديث" : "Refresh"; icon: @image-url("../assets/icons/refresh.svg"); quiet: true; clicked => { AppState.refresh_devices(); } }
            FlowButton { text: AppState.rtl ? "رجوع" : "Back"; quiet: true; clicked => { AppState.show_devices = false; } }
        }
        if AppState.peers.length > 0 : Panel {
            VerticalLayout { padding: 10px; spacing: 2px; for peer in AppState.peers : DeviceRow { item: peer; } }
        }
        if AppState.peers.length == 0 : Panel {
            VerticalLayout {
                padding: 24px; spacing: 18px;
                SectionTitle { text: AppState.rtl ? "لم يظهر جهاز بعد" : "No devices found yet"; }
                BodyText { text: AppState.rtl ? "١. افتح Flow على الجهاز الآخر.\n٢. اتصل بالشبكة المحلية نفسها.\n٣. اضغط تحديث عندما يصبح الجهاز جاهزًا." : "1. Open Flow on your other device.\n2. Connect both to the same local network.\n3. Refresh when the other device is ready."; color: Theme.secondary; }
                SmallText { text: AppState.rtl ? "نقاط الاتصال مدعومة. قد تمنع الشبكات العامة الأجهزة من رؤية بعضها." : "Hotspots work too. Public networks may prevent devices from finding each other."; }
            }
        }
    }
}

component ActivityPage inherits ScrollView {
    in property <bool> compact;
    private property <bool> confirm_clear: false;
    VerticalLayout {
        padding: root.compact ? 16px : 24px; spacing: 18px;
        FlowRow {
            SectionTitle { text: AppState.rtl ? "السجل" : "Activity"; font-size: 21px; horizontal-stretch: 1; }
            if AppState.history_items.length > 0 : FlowButton { text: AppState.rtl ? "مسح السجل" : "Clear history"; quiet: true; clicked => { root.confirm_clear = true; } }
        }
        if root.confirm_clear : Panel {
            VerticalLayout {
                padding: 18px; spacing: 14px;
                BodyText { text: AppState.rtl ? "مسح السجل؟ ستبقى الملفات محفوظة." : "Clear activity? Your files will be kept."; }
                FlowRow {
                    alignment: end;
                    FlowButton { text: AppState.rtl ? "إلغاء" : "Cancel"; quiet: true; clicked => { root.confirm_clear = false; } }
                    FlowButton { text: AppState.rtl ? "مسح" : "Clear"; danger: true; clicked => { AppState.clear_history(); root.confirm_clear = false; } }
                }
            }
        }
        if AppState.history_items.length == 0 : Panel {
            VerticalLayout {
                padding: 24px; spacing: 16px;
                SectionTitle { text: AppState.rtl ? "لا توجد عمليات نقل بعد" : "No transfers yet"; }
                SmallText { text: AppState.rtl ? "ستجد الملفات والنصوص التي ترسلها وتستلمها هنا." : "Files and text you send or receive will appear here."; }
                FlowButton { text: AppState.rtl ? "إرسال ملف" : "Send a file"; clicked => { AppState.show_history = false; } }
            }
        }
        if AppState.history_items.length > 0 : Panel {
            VerticalLayout { padding-left: 18px; padding-right: 18px; for entry in AppState.history_items : HistoryRow { item: entry; } }
        }
    }
}

component SettingsPage inherits ScrollView {
    in property <bool> compact;
    VerticalLayout {
        padding: root.compact ? 16px : 24px; spacing: 18px;
        SectionTitle { text: AppState.rtl ? "الإعدادات" : "Settings"; font-size: 21px; }
        Panel {
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 8px; padding-bottom: 8px;
                SettingRow { title: AppState.rtl ? "المظهر الداكن" : "Dark appearance"; description: AppState.rtl ? "خلفية AMOLED سوداء ونصوص فضية." : "AMOLED black with silver text."; value <=> AppState.dark_mode; }
                Separator { }
                FlowRow {
                    min-height: 78px;
                    BodyText { text: AppState.rtl ? "اللغة" : "Language"; horizontal-stretch: 1; }
                    FlowButton { text: "English"; selected: !AppState.rtl; clicked => { AppState.lang = "EN"; AppState.save_settings(); } }
                    FlowButton { text: "العربية"; selected: AppState.rtl; clicked => { AppState.lang = "AR"; AppState.save_settings(); } }
                }
            }
        }
        Panel {
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 8px; padding-bottom: 8px;
                SettingRow { title: AppState.rtl ? "تنظيف الروابط" : "Clean links"; description: AppState.rtl ? "إزالة معاملات التتبع عند إرسال النص." : "Remove tracking parameters when sending text."; value <=> AppState.clean_links; }
                Separator { }
                SettingRow { title: AppState.rtl ? "نسخ النص المستلم تلقائيًا" : "Copy received text automatically"; description: AppState.rtl ? "يستبدل محتوى الحافظة الحالي." : "Replaces your current clipboard contents."; value <=> AppState.auto_copy; }
            }
        }
        Panel {
            VerticalLayout {
                padding: 20px; spacing: 14px;
                FlowRow {
                    BodyText { text: AppState.rtl ? "الملفات المستلمة" : "Received files"; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.mobile_mode ? (AppState.rtl ? "تصفح" : "Browse") : (AppState.rtl ? "فتح" : "Open"); icon: @image-url("../assets/icons/folder.svg"); quiet: true; clicked => { AppState.open_downloads(); } }
                }
                SmallText { text: AppState.download_path; horizontal-alignment: left; wrap: word-wrap; }
            }
        }
        Panel {
            VerticalLayout {
                padding: 20px; spacing: 12px;
                FlowRow {
                    BodyText { text: AppState.rtl ? "الأجهزة المقترنة" : "Paired devices"; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "إضافة جهاز" : "Add device"; quiet: true; clicked => { AppState.show_devices = true; } }
                }
                if AppState.trusted_devices.length == 0 : SmallText { text: AppState.rtl ? "لم تقترن بأي جهاز بعد." : "No paired devices yet."; }
                for peer in AppState.trusted_devices : FlowRow {
                    min-height: 60px;
                    BodyText { text: peer.name; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; }
                    FlowButton { text: AppState.rtl ? "إلغاء الاقتران" : "Forget"; danger: true; quiet: true; clicked => { AppState.forget_device(peer.id); } }
                }
            }
        }
        Panel {
            VerticalLayout {
                padding: 20px; spacing: 14px;
                FlowRow {
                    BodyText { text: AppState.rtl ? "التحديثات" : "Updates"; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "الإصدارات" : "Releases"; quiet: true; clicked => { AppState.open_update(); } }
                }
                SmallText { text: AppState.rtl ? "الإصدار الحالي: " + AppState.app_version : "Current version: " + AppState.app_version; }
                if AppState.update_available : BodyText {
                    text: AppState.rtl ? "إصدار متاح: " + AppState.update_version : "Available version: " + AppState.update_version;
                    font-weight: 600;
                }
                SmallText {
                    text: AppState.update_status != "" ? AppState.update_status : (AppState.rtl ? "افحص وجود إصدار أحدث من Flow." : "Check for a newer version of Flow.");
                    color: AppState.update_error ? Theme.error : Theme.secondary;
                    wrap: word-wrap;
                }
                FlexboxLayout {
                    flex-direction: AppState.mobile_mode || AppState.compact_mode ? column : (AppState.rtl ? row-reverse : row);
                    flex-wrap: no-wrap; alignment: stretch; cross-axis-alignment: stretch; spacing: 10px;
                    FlowButton {
                        text: AppState.update_busy ? (AppState.rtl ? "يرجى الانتظار…" : "Please wait…") : (AppState.rtl ? "فحص التحديثات" : "Check for updates");
                        icon: @image-url("../assets/icons/refresh.svg");
                        enabled: !AppState.update_busy && !AppState.update_waiting_confirmation; horizontal-stretch: 1;
                        clicked => { AppState.check_updates(); }
                    }
                    if AppState.update_available : FlowButton {
                        text: AppState.rtl ? "تثبيت التحديث" : "Install update";
                        primary: true; horizontal-stretch: 1;
                        enabled: !AppState.update_busy && !AppState.update_blocked && !AppState.update_waiting_confirmation;
                        clicked => { AppState.apply_update(); }
                    }
                }
                if AppState.update_waiting_confirmation : FlowButton {
                    text: AppState.rtl ? "استئناف النقل" : "Resume transfers";
                    quiet: true;
                    clicked => { AppState.resume_after_update(); }
                }
                if AppState.update_available && AppState.update_blocked && !AppState.update_busy : SmallText {
                    text: AppState.rtl ? "انتظر انتهاء النقل قبل تثبيت التحديث." : "Wait for your transfers to finish before installing.";
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Flow";
    min-width: AppState.mobile_mode ? 320px : 680px;
    min-height: AppState.mobile_mode ? 480px : 540px;
    preferred-width: AppState.mobile_mode ? 390px : 920px;
    preferred-height: AppState.mobile_mode ? 820px : 690px;
    default-font-family: "Noto Sans Arabic";
    default-font-size: AppState.rtl ? 16px : 15px;
    forward-focus: keys;
    background: AppState.dark_mode ? #000000 : AppState.native_glass ? transparent : Theme.background;
    private property <bool> compact: AppState.mobile_mode || AppState.compact_mode;
    Rectangle {
        width: parent.width; height: parent.height;
        background: AppState.dark_mode ? #000000 : AppState.native_glass ? Theme.native_tint : Theme.backdrop;
    }
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Back || event.text == Key.Escape) {
                if (AppState.show_file_picker) { AppState.close_file_browser(); return accept; }
                if (AppState.show_pairing) { AppState.show_pairing = false; return accept; }
                if (AppState.show_devices) { AppState.show_devices = false; return accept; }
                if (AppState.show_history) { AppState.show_history = false; return accept; }
                if (AppState.show_settings) { AppState.show_settings = false; return accept; }
                return reject;
            }
            if (event.modifiers.control && (event.text == "o" || event.text == "O") && !AppState.busy) {
                if (AppState.is_connected) { AppState.send_files(); } else { AppState.show_devices = true; }
                return accept;
            }
            if (event.modifiers.control && event.text == Key.Return && AppState.is_connected && AppState.draft_text != "" && !AppState.busy) { AppState.send_text(AppState.draft_text); return accept; }
            return reject;
        }
        VerticalLayout {
            padding-top: root.safe-area-insets.top; padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left; padding-right: root.safe-area-insets.right;
            Rectangle {
                background: AppState.dark_mode ? #ffffff05 : #ffffff2c;
                min-height: root.compact ? 108px : 66px;
                VerticalLayout {
                    padding-left: root.compact ? 16px : 24px; padding-right: root.compact ? 16px : 24px;
                    padding-top: 12px; padding-bottom: 12px; spacing: 10px;
                    FlexboxLayout {
                        flex-direction: root.compact ? column : (AppState.rtl ? row-reverse : row);
                        flex-wrap: no-wrap; alignment: stretch; cross-axis-alignment: center; spacing: 12px;
                        FlowRow {
                            horizontal-stretch: 1; spacing: 10px;
                            BodyText { text: "Flow"; font-size: 23px; font-weight: 600; }
                            Rectangle { width: 5px; height: 5px; border-radius: 3px; background: AppState.is_connected ? Theme.success : Theme.muted; }
                            SmallText { text: AppState.busy ? (AppState.rtl ? "جارٍ الإرسال" : "Sending") : (AppState.rtl ? "نقل محلي" : "Local transfer"); color: Theme.secondary; horizontal-stretch: 1; }
                        }
                        FlowRow {
                            spacing: 4px; horizontal-stretch: root.compact ? 1 : 0;
                            FlowButton { text: AppState.rtl ? "النقل" : "Transfer"; quiet: true; selected: !AppState.show_history && !AppState.show_settings; horizontal-stretch: root.compact ? 1 : 0; clicked => { AppState.show_history = false; AppState.show_settings = false; AppState.show_devices = false; AppState.show_pairing = false; if (AppState.show_file_picker) { AppState.close_file_browser(); } } }
                            FlowButton { text: AppState.rtl ? "السجل" : "Activity"; quiet: true; selected: AppState.show_history; horizontal-stretch: root.compact ? 1 : 0; clicked => { AppState.show_history = true; AppState.show_settings = false; AppState.show_devices = false; AppState.show_pairing = false; if (AppState.show_file_picker) { AppState.close_file_browser(); } } }
                            FlowButton { text: AppState.rtl ? "الإعدادات" : "Settings"; quiet: true; selected: AppState.show_settings; horizontal-stretch: root.compact ? 1 : 0; clicked => { AppState.show_settings = true; AppState.show_history = false; AppState.show_devices = false; AppState.show_pairing = false; if (AppState.show_file_picker) { AppState.close_file_browser(); } } }
                        }
                    }
                }
                Separator { y: parent.height - 1px; }
            }
            if AppState.notice != "" : Rectangle {
                background: AppState.notice_error ? Theme.error_soft : Theme.subtle;
                min-height: root.compact ? 76px : 58px;
                FlowRow {
                    padding-left: root.compact ? 16px : 24px; padding-right: root.compact ? 16px : 24px;
                    BodyText { text: AppState.notice; color: AppState.notice_error ? Theme.error : Theme.text; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "إغلاق" : "Dismiss"; quiet: true; clicked => { AppState.dismiss_notice(); } }
                }
            }
            if AppState.show_file_picker : FileBrowser { vertical-stretch: 1; }
            if !AppState.show_file_picker && AppState.show_pairing : PairingPane { vertical-stretch: 1; }
            if !AppState.show_file_picker && !AppState.show_pairing && AppState.show_devices : DevicePage { compact: root.compact; vertical-stretch: 1; }
            if !AppState.show_file_picker && !AppState.show_pairing && !AppState.show_devices && AppState.show_settings : SettingsPage { compact: root.compact; vertical-stretch: 1; }
            if !AppState.show_file_picker && !AppState.show_pairing && !AppState.show_devices && !AppState.show_settings && AppState.show_history : ActivityPage { compact: root.compact; vertical-stretch: 1; }
            if !AppState.show_file_picker && !AppState.show_pairing && !AppState.show_devices && !AppState.show_settings && !AppState.show_history : HomePage { compact: root.compact; vertical-stretch: 1; }
        }
    }
}
