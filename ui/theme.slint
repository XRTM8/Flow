import { AppState } from "state.slint";

export global Theme {
    out property <color> background: AppState.dark_mode ? #000000 : #e7e9ed;
    out property <brush> backdrop: AppState.dark_mode
        ? #000000
        : @linear-gradient(145deg, #f6f7f9e8 0%, #e3e6ebe8 62%, #d4d9e0e8 100%);
    out property <brush> native_tint: AppState.dark_mode
        ? #000000
        : @linear-gradient(150deg, #f4f6f8a8 0%, #dce1e8b8 100%);
    out property <brush> surface: AppState.dark_mode
        ? @linear-gradient(180deg, #191d24d0 0%, #11151cdb 100%)
        : @linear-gradient(180deg, #ffffffc9 0%, #f1f3f6b8 100%);
    out property <color> field: AppState.dark_mode ? #080b10d9 : #ffffffa8;
    out property <color> subtle: AppState.dark_mode ? #ffffff07 : #ffffff5c;
    out property <color> hover: AppState.dark_mode ? #ffffff11 : #ffffffa3;
    out property <color> pressed: AppState.dark_mode ? #ffffff1c : #cbd1da85;
    out property <color> border: AppState.dark_mode ? #ffffff1a : #5f6c802b;
    out property <color> edge: AppState.dark_mode ? #ffffff26 : #ffffffd6;
    out property <color> text: AppState.dark_mode ? #dce2eb : #242a33;
    out property <color> heading: AppState.dark_mode ? #eef1f5 : #242a33;
    out property <color> secondary: AppState.dark_mode ? #adb6c4 : #515d6f;
    out property <color> muted: AppState.dark_mode ? #8e99ab : #657186;
    out property <color> focus: AppState.dark_mode ? #cbd3df : #53647d;
    out property <color> accent: AppState.dark_mode ? #d5dde8 : #39465a;
    out property <color> accent_soft: AppState.dark_mode ? #ffffff0f : #ffffffb0;
    out property <brush> primary: AppState.dark_mode ? @linear-gradient(180deg, #e0e5ec 0%, #b9c2ce 100%) : @linear-gradient(180deg, #f9fafb 0%, #d5dae2 100%);
    out property <brush> primary_hover: AppState.dark_mode ? @linear-gradient(180deg, #edf0f5 0%, #c9d1dc 100%) : @linear-gradient(180deg, #ffffff 0%, #e3e7ed 100%);
    out property <brush> primary_pressed: AppState.dark_mode ? @linear-gradient(180deg, #acb7c6 0%, #cad2dd 100%) : @linear-gradient(180deg, #cbd2dc 0%, #e3e7ed 100%);
    out property <color> primary_border: #9aa7b6a6;
    out property <color> on_primary: #202935;
    out property <color> accent_fill: AppState.dark_mode ? #c6d0dd : #64748b;
    out property <color> accent_hover: AppState.dark_mode ? #e0e5ec : #4a5c73;
    out property <color> selection: AppState.dark_mode ? #c6d0dd : #465c78;
    out property <color> on_selection: AppState.dark_mode ? #18212e : #ffffff;
    out property <color> disabled: AppState.dark_mode ? #ffffff08 : #ffffff38;
    out property <color> disabled_text: AppState.dark_mode ? #8e98a7 : #7b8798;
    out property <color> success: AppState.dark_mode ? #b1d3bf : #35634c;
    out property <color> warning: AppState.dark_mode ? #ddc6a1 : #7f5c2a;
    out property <color> error: AppState.dark_mode ? #e4b1b1 : #943e44;
    out property <color> error_soft: AppState.dark_mode ? #7a323226 : #b34c4c12;
    out property <color> shadow: AppState.dark_mode ? #00000020 : #2838510c;
    out property <length> radius: 14px;
}
