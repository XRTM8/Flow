export global Theme {
    // فلسفة الأوبسيديان الفاخرة (Obsidian Slate Minimalist)
    in property <color> background: #0b0d13;
    in property <color> surface: #121620;
    in property <color> surface-hover: #191f2d;
    in property <color> surface-pressed: #1d2536;
    in property <color> recessed: #07090e;
    in property <color> border: #1d2333;
    in property <color> border-subtle: #161b27;
    in property <color> border-focus: #3b82f6;

    in property <color> text-primary: #f8fafc;
    in property <color> text-secondary: #94a3b8;
    in property <color> text-muted: #64748b;
    in property <color> text-faint: #475569;

    in property <color> accent: #10b981; // زمردي طبيعي هادئ
    in property <color> accent-glow: #10b98118;
    in property <color> accent-hover: #059669;

    in property <color> status-online: #10b981;
    in property <color> status-waiting: #f59e0b;
    in property <color> status-error: #ef4444;

    in property <length> radius-sm: 8px;
    in property <length> radius-md: 14px;
    in property <length> radius-lg: 20px;
}
