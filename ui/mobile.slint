import { Theme } from "theme.slint";
import { HistoryItem, FilePickerItem } from "models.slint";
import { ScrollView } from "std-widgets.slint";

export component MobileApp inherits Window {
    title: "Otium Flow";
    background: Theme.background;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

    // المتغيرات الخاصة بالهاتف مع مراعاة منطقة البردة وشريط الإيماءات السفلي
    in-out property <length> safe_area_top: 48px;
    in-out property <length> safe_area_bottom: 34px;

    in-out property <string> peer_name: "Scanning Wi-Fi...";
    in-out property <bool> is_connected: false;
    in-out property <string> last_received_text: "No text received yet";
    in-out property <bool> text_cleaned: false;
    in-out property <bool> transfer_active: false;
    in-out property <string> transfer_name: "";
    in-out property <float> transfer_progress: 0.0;
    in-out property <string> transfer_status: "";
    in-out property <bool> show_history: false;
    in-out property <[HistoryItem]> history_items: [];
    in-out property <bool> clipboard_copied: false;
    in-out property <bool> clipboard_pushed: false;
    in-out property <string> sas_code: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_in_progress: false;

    // استعراض واختيار الملفات داخل التطبيق للهاتف
    in-out property <bool> show_file_picker: false;
    in-out property <[FilePickerItem]> picker_files: [];

    callback share_file_clicked();
    callback push_clipboard_clicked();
    callback copy_received_clicked();
    callback toggle_history();
    callback clear_history();
    callback cancel_transfer_clicked();
    callback apply_update_clicked();
    callback file_selected(string);
    callback close_file_picker();
    callback create_test_file();

    VerticalLayout {
        // نطبق مسافة الأمان العلوية (البردة) والسفلية تلقائياً
        padding-top: root.safe_area_top + 12px;
        padding-bottom: root.safe_area_bottom + 12px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        // 1. رأس الهاتف المريح (Below the Notch)
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "FLOW";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        letter-spacing: 1.5px;
                    }
                    Text {
                        text: "by Otium";
                        font-size: 11px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }
            }

            // أزرار الحالة والسجل في رأس النافذة
            HorizontalLayout {
                spacing: 8px;

                if root.update_available : Rectangle {
                    background: update-touch-m.pressed ? #3b82f644 : update-touch-m.has-hover ? #3b82f628 : #3b82f618;
                    border-width: 1px;
                    border-color: #3b82f655;
                    border-radius: 14px;
                    height: 28px;
                    animate background { duration: 120ms; }
                    update-touch-m := TouchArea {
                        clicked => { root.apply_update_clicked(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: root.update_in_progress ? "Updating..." : "Up " + root.update_version;
                            font-size: 11px;
                            font-weight: 600;
                            color: #60a5fa;
                            vertical-alignment: center;
                        }
                    }
                }

                // مؤشر الاتصال بالحاسوب
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 14px;
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.is_connected ? Theme.status-online : Theme.status-waiting;
                            border-width: 1px;
                            border-color: root.is_connected ? #10b98144 : #f59e0b44;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.peer_name;
                            font-size: 12px;
                            font-weight: 500;
                            color: root.is_connected ? Theme.text-secondary : Theme.text-muted;
                            vertical-alignment: center;
                        }

                        if root.is_connected && root.sas_code != "" : Rectangle {
                            background: Theme.recessed;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "#" + root.sas_code;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // زر فتح سجل النشاط في الهاتف (أيقونة متجهات نقية بدون خطوط خارجية)
                Rectangle {
                    width: 32px;
                    height: 28px;
                    border-radius: 14px;
                    background: hist-touch.pressed ? Theme.surface-pressed : hist-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: root.show_history ? Theme.accent : Theme.border;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    hist-touch := TouchArea {
                        clicked => { root.toggle_history(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        width: 14px;
                        height: 11px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        Rectangle { width: 14px; height: 1.5px; border-radius: 1px; background: root.show_history ? Theme.accent : Theme.text-secondary; }
                        Rectangle { width: 14px; height: 1.5px; border-radius: 1px; background: root.show_history ? Theme.accent : Theme.text-secondary; }
                        Rectangle { width: 14px; height: 1.5px; border-radius: 1px; background: root.show_history ? Theme.accent : Theme.text-secondary; }
                    }
                }
            }
        }

        // 2. بطاقة النقل النشط (إذا كان هناك ملف يتم استقباله أو إرساله)
        if root.transfer_active : Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            height: 64px;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.transfer_name;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-primary;
                        overflow: elide;
                        width: 180px;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            background: Theme.recessed;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 22px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.transfer_status;
                                    font-size: 11px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 34px;
                            height: 28px;
                            border-radius: 14px;
                            background: cancel-mobile-touch.pressed ? #ef444433 : cancel-mobile-touch.has-hover ? #ef444422 : #00000000;
                            animate background { duration: 120ms; }
                            cancel-mobile-touch := TouchArea {
                                clicked => { root.cancel_transfer_clicked(); }
                            }
                            Text {
                                text: "x";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.status-error;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.recessed;

                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width * root.transfer_progress;
                        border-radius: 2.5px;
                        background: Theme.accent;
                        animate width { duration: 100ms; easing: ease-out; }
                    }
                }
            }
        }

        // 3. مساحة استعراض الحافظة والنصوص المستلمة
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            Text {
                text: "RECEIVED ON THIS DEVICE";
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
                letter-spacing: 1.2px;
            }

            Rectangle {
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-md;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Clipboard Sync";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.text-secondary;
                        }

                        if root.text_cleaned : Rectangle {
                            background: #10b98115;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #10b98133;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "Cleaned";
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // صندوق النص
                    Rectangle {
                        background: Theme.recessed;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        vertical-stretch: 1;

                        Text {
                            text: root.last_received_text;
                            font-size: 14px;
                            color: root.last_received_text == "No text received yet" ? Theme.text-faint : Theme.text-primary;
                            wrap: word-wrap;
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            height: parent.height - 24px;
                        }
                    }

                    // زر النسخ السريع للهاتف
                    Rectangle {
                        background: copy-btn.pressed ? Theme.surface-pressed : copy-btn.has-hover ? Theme.surface-hover : #151a26;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-sm;
                        height: 38px;
                        animate background { duration: 120ms; }

                        copy-btn := TouchArea {
                            clicked => { root.copy_received_clicked(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: root.clipboard_copied ? "Copied to Clipboard" : "Copy to Clipboard";
                                font-size: 13px;
                                font-weight: 500;
                                color: root.clipboard_copied ? Theme.accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // 4. منطقة أزرار الإبهام السفلية (One-Handed Thumb Zone)
        VerticalLayout {
            spacing: 10px;

            // زر إرسال ملف / صورة (الزر الأساسي البارز)
            Rectangle {
                background: file-btn.pressed ? Theme.accent-hover : file-btn.has-hover ? #059669 : Theme.accent;
                border-radius: Theme.radius-md;
                height: 52px;
                animate background { duration: 120ms; }

                file-btn := TouchArea {
                    clicked => { root.share_file_clicked(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "Send File or Photo";
                        font-size: 15px;
                        font-weight: 600;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }

            // زر إرسال حافظة الهاتف إلى الحاسوب
            Rectangle {
                background: clip-btn.pressed ? Theme.surface-pressed : clip-btn.has-hover ? Theme.surface-hover : Theme.surface;
                border-width: 1px;
                border-color: clip-btn.has-hover ? Theme.border-focus : Theme.border;
                border-radius: Theme.radius-md;
                height: 44px;
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }

                clip-btn := TouchArea {
                    clicked => { root.push_clipboard_clicked(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: root.clipboard_pushed ? "Sent to PC" : "Push Clipboard to PC";
                        font-size: 13px;
                        font-weight: 500;
                        color: root.clipboard_pushed ? Theme.accent : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // 5. نافذة اختيار الملفات داخل التطبيق للهاتف (In-App File Picker Sheet)
    if root.show_file_picker : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0b0d13fa;
        x: 0;
        y: 0;
        z: 100;

        VerticalLayout {
            padding-top: root.safe_area_top + 12px;
            padding-bottom: root.safe_area_bottom + 12px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "SELECT FILE TO SEND";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 32px;
                    height: 30px;
                    border-radius: 15px;
                    background: close-fp-touch.pressed ? Theme.surface-pressed : close-fp-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 120ms; }
                    close-fp-touch := TouchArea {
                        clicked => { root.close_file_picker(); }
                    }
                    Text {
                        text: "x";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            if root.picker_files.length == 0 : VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: 12px;
                Text {
                    text: "No files found in Downloads or Pictures";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Place files in /Download to share instantly";
                    font-size: 11px;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 210px;
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    test-btn-touch := TouchArea {
                        clicked => { root.create_test_file(); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Create & Send Test File";
                            font-size: 13px;
                            font-weight: 600;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.picker_files.length > 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for f in root.picker_files : Rectangle {
                        background: f-touch.pressed ? #10b98122 : f-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: f-touch.has-hover ? Theme.accent : Theme.border;
                        border-radius: Theme.radius-sm;
                        height: 52px;
                        animate background { duration: 100ms; }

                        f-touch := TouchArea {
                            clicked => { root.file_selected(f.path); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: #10b98118;
                                border-width: 1px;
                                border-color: #10b98133;
                                y: (parent.height - self.height) / 2;
                                Text {
                                    text: "F";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: f.name;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: f.size_str;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }

                            Text {
                                text: "Send";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.accent;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // 6. واجهة سجل التحويلات المنبثقة للهاتف
    if root.show_history : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0b0d13fa;
        x: 0;
        y: 0;
        z: 100;

        VerticalLayout {
            padding-top: root.safe_area_top + 12px;
            padding-bottom: root.safe_area_bottom + 12px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 14px;

            // شريط رأس السجل
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "ACTIVITY HISTORY";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;

                    if root.history_items.length > 0 : Rectangle {
                        background: clear-hist-touch.pressed ? Theme.surface-pressed : clear-hist-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: 6px;
                        height: 30px;
                        animate background { duration: 120ms; }
                        clear-hist-touch := TouchArea {
                            clicked => { root.clear_history(); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "Clear";
                                font-size: 11px;
                                font-weight: 500;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 30px;
                        border-radius: 15px;
                        background: close-touch.pressed ? Theme.surface-pressed : close-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 120ms; }
                        close-touch := TouchArea {
                            clicked => { root.toggle_history(); }
                        }
                        Text {
                            text: "x";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            if root.history_items.length == 0 : VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                Text {
                    text: "No transfers yet";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }

            if root.history_items.length > 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for item in root.history_items : Rectangle {
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-sm;
                        height: 52px;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: item.kind == "file" ? #10b98118 : #3b82f618;
                                border-width: 1px;
                                border-color: item.kind == "file" ? #10b98133 : #3b82f633;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: item.kind == "file" ? "F" : "C";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: item.kind == "file" ? Theme.accent : #60a5fa;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: item.title;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.subtitle;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }

                            Text {
                                text: item.timestamp;
                                font-size: 11px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
