import { Theme } from "theme.slint";
import { HistoryItem, FilePickerItem } from "models.slint";
import { ScrollView } from "std-widgets.slint";

export component MobileApp inherits Window {
    title: "Otium Flow — Ultra P2P Mesh";
    background: Theme.background;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

    // المتغيرات الخاصة بالهاتف مع مراعاة منطقة البردة وشريط الإيماءات السفلي
    in-out property <length> safe_area_top: 48px;
    in-out property <length> safe_area_bottom: 34px;

    in-out property <string> peer_name: "Scanning Wi-Fi...";
    in-out property <bool> is_connected: false;
    in-out property <string> last_received_text: "No text received yet";
    in-out property <bool> text_cleaned: false;
    in-out property <bool> transfer_active: false;
    in-out property <string> transfer_name: "";
    in-out property <float> transfer_progress: 0.0;
    in-out property <string> transfer_status: "";
    in-out property <bool> show_history: false;
    in-out property <[HistoryItem]> history_items: [];
    in-out property <bool> clipboard_copied: false;
    in-out property <bool> clipboard_pushed: false;
    in-out property <string> sas_code: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_in_progress: false;

    // استعراض واختيار الملفات داخل التطبيق للهاتف
    in-out property <bool> show_file_picker: false;
    in-out property <[FilePickerItem]> picker_files: [];

    // محرر الملاحظات والنصوص المباشر للهاتف
    in-out property <string> draft_text: "";
    in-out property <bool> text_sent: false;
    in-out property <string> active_tab: "beam"; // "beam" or "history"

    callback share_file_clicked();
    callback push_clipboard_clicked();
    callback copy_received_clicked();
    callback toggle_history();
    callback clear_history();
    callback cancel_transfer_clicked();
    callback apply_update_clicked();
    callback file_selected(string);
    callback close_file_picker();
    callback create_test_file();

    // Callbacks للمحرر المباشر
    callback send_custom_text(string);
    callback paste_to_draft();
    callback clear_draft();

    VerticalLayout {
        padding-top: root.safe_area_top + 10px;
        padding-bottom: root.safe_area_bottom + 12px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;

        // 1. رأس شاشة الهاتف الفاخرة (Top Header & Telemetry Pill)
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 9px;
                    background: #0e1726;
                    border-width: 1px;
                    border-color: Theme.accent-glow;

                    Text {
                        text: "⚡";
                        font-size: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout {
                        spacing: 5px;
                        Text {
                            text: "FLOW";
                            font-size: 17px;
                            font-weight: 800;
                            color: Theme.text-primary;
                            letter-spacing: 1.5px;
                        }
                        Text {
                            text: "P2P";
                            font-size: 9px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: "by Otium";
                        font-size: 10px;
                        color: Theme.text-muted;
                    }
                }
            }

            // أدوات الحالة والتبديل
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // كبسولة الاتصال
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? Theme.accent-glow : Theme.border;
                    border-radius: 14px;
                    height: 30px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.is_connected ? Theme.status-online : Theme.status-waiting;
                            border-width: 1px;
                            border-color: root.is_connected ? #00d2ff88 : #f59e0b88;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.peer_name;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.is_connected ? Theme.text-primary : Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        if root.is_connected && root.sas_code != "" : Rectangle {
                            background: #00d2ff18;
                            border-radius: 4px;
                            height: 18px;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text {
                                    text: "#" + root.sas_code;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // زر التبديل بين الاستوديو وسجل النشاط
                Rectangle {
                    width: 32px;
                    height: 30px;
                    border-radius: 15px;
                    background: root.active_tab == "history" ? #18253e : Theme.surface;
                    border-width: 1px;
                    border-color: root.active_tab == "history" ? Theme.border-focus : Theme.border;
                    animate background { duration: 120ms; }

                    tab-toggle-touch := TouchArea {
                        clicked => {
                            if root.active_tab == "beam" {
                                root.active_tab = "history";
                            } else {
                                root.active_tab = "beam";
                            }
                        }
                    }

                    Text {
                        text: root.active_tab == "history" ? "⚡" : "🕒";
                        font-size: 13px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        // 2. بطاقة النقل النشط (Telemetry Transfer HUD)
        if root.transfer_active : Rectangle {
            background: #0c121e;
            border-width: 1px;
            border-color: Theme.accent;
            border-radius: Theme.radius-sm;
            height: 64px;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.transfer_name;
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                            width: 180px;
                        }
                        Text {
                            text: root.transfer_status;
                            font-size: 10px;
                            color: Theme.accent;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: Math.round(root.transfer_progress * 100) + "%";
                            font-size: 12px;
                            font-weight: 700;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 26px;
                            height: 24px;
                            border-radius: 6px;
                            background: cancel-mobile-touch.pressed ? #f43f5e33 : #1c263c;
                            border-width: 1px;
                            border-color: #f43f5e55;
                            cancel-mobile-touch := TouchArea {
                                clicked => { root.cancel_transfer_clicked(); }
                            }
                            Text {
                                text: "x";
                                font-size: 12px;
                                font-weight: 700;
                                color: Theme.status-error;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: #070a10;

                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width * root.transfer_progress;
                        border-radius: 2.5px;
                        background: Theme.accent;
                        animate width { duration: 100ms; easing: ease-out; }
                    }
                }
            }
        }

        // 3. المحتوى الرئيسي (حسب التبويب المختار)
        if root.active_tab == "beam" : ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 12px;

                // ===== البطاقة 1: محرر الملاحظات والنصوص المباشر (تكتب وتدز مباشرة) =====
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: draft-mobile-input.has-focus ? Theme.border-focus : Theme.border;
                    border-radius: Theme.radius-md;
                    height: 190px;
                    animate border-color { duration: 120ms; }

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "BEAM NOTE TO PC";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    letter-spacing: 1px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                // زر لصق ما في ذاكرة الهاتف بلمسة واحدة
                                Rectangle {
                                    background: paste-m-touch.pressed ? #1c263c : #0e1422;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 6px;
                                    height: 24px;
                                    paste-m-touch := TouchArea {
                                        clicked => { root.paste_to_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "📋 Paste";
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.draft_text != "" : Rectangle {
                                    background: #f43f5e22;
                                    border-radius: 6px;
                                    height: 24px;
                                    clear-m-touch := TouchArea {
                                        clicked => { root.clear_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "🧹";
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // صندوق إدخال النص
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            if root.draft_text == "" : Text {
                                text: "Type any note, message, link, or text to beam directly to PC...";
                                font-size: 12px;
                                color: Theme.text-faint;
                                wrap: word-wrap;
                                x: 10px;
                                y: 10px;
                                width: parent.width - 20px;
                            }

                            draft-mobile-input := TextInput {
                                text <=> root.draft_text;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: Theme.text-primary;
                                selection-background-color: #00d2ff44;
                                selection-foreground-color: #ffffff;
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                            }
                        }

                        // زر إرسال الملاحظة مباشرة للحاسوب
                        Rectangle {
                            background: send-beam-m-touch.pressed ? #0284c7 : #0369a1;
                            border-width: 1px;
                            border-color: Theme.accent;
                            border-radius: Theme.radius-sm;
                            height: 38px;
                            animate background { duration: 120ms; }

                            send-beam-m-touch := TouchArea {
                                clicked => { root.send_custom_text(root.draft_text); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.text_sent ? "✓ Beamed to PC!" : "🚀 Beam Note to PC";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ===== البطاقة 2: مركز إرسال ومشاركة الملفات السريعة =====
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 140px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "FILE & MEDIA SHARE";
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-muted;
                            letter-spacing: 1px;
                        }

                        // الزر الأساسي البارز لاختيار ومشاركة الملفات
                        Rectangle {
                            background: share-btn-m.pressed ? #0284c7 : #0369a1;
                            border-width: 1px;
                            border-color: Theme.accent;
                            border-radius: Theme.radius-sm;
                            height: 44px;
                            animate background { duration: 120ms; }

                            share-btn-m := TouchArea {
                                clicked => { root.share_file_clicked(); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "📁 Select & Beam Files / Photos";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // صف الإجراءات السريعة
                        HorizontalLayout {
                            spacing: 8px;

                            // زر دفع الحافظة المباشر
                            Rectangle {
                                background: Theme.surface-hover;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 6px;
                                height: 34px;
                                horizontal-stretch: 1;

                                push-clip-touch-m := TouchArea {
                                    clicked => { root.push_clipboard_clicked(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: root.clipboard_pushed ? "✓ Sent Clip" : "📋 Push Clipboard";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.clipboard_pushed ? Theme.accent : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // زر اختبار النقل الفوري
                            Rectangle {
                                background: #0e1726;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                border-radius: 6px;
                                height: 34px;
                                horizontal-stretch: 1;

                                test-file-touch-m := TouchArea {
                                    clicked => { root.create_test_file(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text {
                                        text: "⚡ Instant Test";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== البطاقة 3: النصوص المستلمة من الحاسوب =====
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 130px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "RECEIVED ON THIS DEVICE";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                letter-spacing: 1px;
                            }

                            if root.text_cleaned : Rectangle {
                                background: #00d2ff18;
                                border-radius: 4px;
                                height: 18px;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: "Cleaned";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // صندوق معاينة النص المستلم
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            Text {
                                text: root.last_received_text;
                                font-size: 12px;
                                color: root.last_received_text == "No text received yet" ? Theme.text-faint : Theme.text-primary;
                                wrap: word-wrap;
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                            }
                        }

                        // زر النسخ
                        Rectangle {
                            background: copy-m-touch.pressed ? #1c263c : #0e1422;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: 6px;
                            height: 28px;
                            copy-m-touch := TouchArea {
                                clicked => { root.copy_received_clicked(); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.clipboard_copied ? "✓ Copied to Phone Clipboard" : "📋 Copy to Phone Clipboard";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: root.clipboard_copied ? Theme.accent : Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. عرض سجل النشاطات للهاتف
        if root.active_tab == "history" : Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-md;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "ACTIVITY HISTORY";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        letter-spacing: 1px;
                    }

                    if root.history_items.length > 0 : Rectangle {
                        background: clear-m-hist.pressed ? #f43f5e33 : #00000000;
                        border-radius: 4px;
                        height: 22px;
                        clear-m-hist := TouchArea {
                            clicked => { root.clear_history(); }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Clear";
                                font-size: 10px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.history_items.length == 0 : VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    spacing: 6px;
                    Text {
                        text: "No transfers yet";
                        font-size: 12px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Beamed files and notes will appear here";
                        font-size: 10px;
                        color: Theme.text-faint;
                        horizontal-alignment: center;
                    }
                }

                if root.history_items.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for item in root.history_items : Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 46px;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 10px;
                                alignment: center;

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: item.kind == "file" ? #00d2ff18 : #6366f118;
                                    border-width: 1px;
                                    border-color: item.kind == "file" ? #00d2ff44 : #6366f144;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.kind == "file" ? "📁" : "⚡";
                                        font-size: 11px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: item.title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: item.subtitle;
                                        font-size: 10px;
                                        color: Theme.text-muted;
                                    }
                                }

                                Text {
                                    text: item.timestamp;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 5. نافذة اختيار الملفات داخل التطبيق للهاتف (In-App File Picker Sheet)
    if root.show_file_picker : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #07090ef5;
        x: 0;
        y: 0;
        z: 100;

        VerticalLayout {
            padding-top: root.safe_area_top + 10px;
            padding-bottom: root.safe_area_bottom + 12px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "SELECT FILE TO BEAM";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 30px;
                    height: 28px;
                    border-radius: 14px;
                    background: close-fp-touch.pressed ? #1c263c : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    close-fp-touch := TouchArea {
                        clicked => { root.close_file_picker(); }
                    }
                    Text {
                        text: "x";
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            if root.picker_files.length == 0 : VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: 10px;
                Text {
                    text: "No files found in Downloads or Pictures";
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Place files in /Download or create a test file below";
                    font-size: 11px;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 220px;
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: #0284c7;
                    border-width: 1px;
                    border-color: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    create-test-touch := TouchArea {
                        clicked => { root.create_test_file(); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "⚡ Create & Send Test File";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.picker_files.length > 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for f in root.picker_files : Rectangle {
                        background: fp-item-touch.pressed ? #162238 : fp-item-touch.has-hover ? #111a2c : Theme.surface;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 48px;

                        fp-item-touch := TouchArea {
                            clicked => { root.file_selected(f.path); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 6px;
                                background: #00d2ff18;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: "📄";
                                    font-size: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: f.name;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: f.size_str;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }

                            Rectangle {
                                width: 60px;
                                height: 26px;
                                border-radius: 6px;
                                background: #00d2ff18;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "Beam";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
