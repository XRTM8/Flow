import { Theme } from "theme.slint";
import { HistoryItem, FilePickerItem } from "models.slint";
import { ScrollView } from "std-widgets.slint";

export component MobileApp inherits Window {
    title: "Otium Flow";
    background: Theme.background;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif";

    // مسافات الأمان للشاشات الحديثة (Notch & Home Indicator)
    in-out property <length> safe_area_top: 48px;
    in-out property <length> safe_area_bottom: 34px;

    // التنقل السفلي الانسيابي بين الواجهات (0: STREAM, 1: FILES, 2: MESH, 3: ACTIVITY)
    in-out property <int> active_tab_index: 0;

    in-out property <string> peer_name: "Scanning Wi-Fi...";
    in-out property <bool> is_connected: false;
    in-out property <string> last_received_text: "No text received yet";
    in-out property <bool> text_cleaned: false;
    in-out property <bool> transfer_active: false;
    in-out property <string> transfer_name: "";
    in-out property <float> transfer_progress: 0.0;
    in-out property <string> transfer_status: "";
    in-out property <bool> show_history: false;
    in-out property <[HistoryItem]> history_items: [];
    in-out property <bool> clipboard_copied: false;
    in-out property <bool> clipboard_pushed: false;
    in-out property <string> sas_code: "";
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_in_progress: false;

    // منتقي الملفات المتطور داخل التطبيق
    in-out property <bool> show_file_picker: false;
    in-out property <[FilePickerItem]> picker_files: [];
    in-out property <string> file_filter: "all"; // all, images, docs, downloads

    // محرر الملاحظات والنصوص المباشر للهاتف
    in-out property <string> draft_text: "";
    in-out property <bool> text_sent: false;
    in-out property <string> lang: "EN"; // "EN" or "AR"

    callback share_file_clicked();
    callback push_clipboard_clicked();
    callback copy_received_clicked();
    callback toggle_history();
    callback clear_history();
    callback cancel_transfer_clicked();
    callback apply_update_clicked();
    callback file_selected(string);
    callback close_file_picker();
    callback create_test_file();
    callback send_custom_text(string);
    callback paste_to_draft();
    callback clear_draft();
    callback open_system_picker_clicked();
    callback open_storage_settings_clicked();

    VerticalLayout {
        padding-top: root.safe_area_top + 8px;
        padding-bottom: root.safe_area_bottom + 8px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;

        // 1. الشريط العلوي النقي (Top Minimalist Omnibar)
        HorizontalLayout {
            alignment: space-between;
            height: 36px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 7px;
                    background: #111726;
                    border-width: 1px;
                    border-color: Theme.accent-glow;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 2px;
                        background: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "FLOW";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-primary;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 12px;
                        background: Theme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "OTIUM";
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text-muted;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }
            }

            // أدوات الحالة وتحديث البرنامج المباشر للهاتف
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Rectangle {
                    background: lang-m-btn.pressed ? #1c263c : lang-m-btn.has-hover ? #172033 : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 14px;
                    height: 28px;
                    lang-m-btn := TouchArea {
                        clicked => { root.lang = root.lang == "EN" ? "AR" : "EN"; }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: root.lang == "EN" ? "AR" : "EN";
                            font-size: 9px;
                            font-weight: 800;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.update_available : Rectangle {
                    background: update-m-btn.pressed ? #3b82f644 : update-m-btn.has-hover ? #3b82f628 : #3b82f618;
                    border-width: 1px;
                    border-color: #3b82f666;
                    border-radius: 14px;
                    height: 28px;
                    animate background { duration: 120ms; }
                    update-m-btn := TouchArea {
                        clicked => { root.apply_update_clicked(); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: root.update_in_progress ? "UPDATING..." : "UPDATE " + root.update_version;
                            font-size: 9px;
                            font-weight: 800;
                            color: #60a5fa;
                            letter-spacing: 0.8px;
                            vertical-alignment: center;
                        }
                    }
                }

                // كبسولة الاتصال
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? Theme.accent-glow : Theme.border;
                    border-radius: 14px;
                    height: 28px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.is_connected ? Theme.status-online : Theme.status-waiting;
                            border-width: 1px;
                            border-color: root.is_connected ? #00d2ff88 : #f59e0b88;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: root.peer_name;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.is_connected ? Theme.text-primary : Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        if root.is_connected && root.sas_code != "" : Rectangle {
                            background: #00d2ff18;
                            border-radius: 4px;
                            height: 16px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "#" + root.sas_code;
                                    font-size: 9px;
                                    font-weight: 800;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // 2. بطاقة النقل النشط (HUD Transfer Telemetry)
        if root.transfer_active : Rectangle {
            background: #0b111c;
            border-width: 1px;
            border-color: Theme.accent;
            border-radius: Theme.radius-sm;
            height: 56px;

            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 4px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.transfer_name;
                            font-size: 11px;
                            font-weight: 700;
                            color: Theme.text-primary;
                            overflow: elide;
                            width: 180px;
                        }
                        Text {
                            text: root.transfer_status;
                            font-size: 9px;
                            color: Theme.accent;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: Math.round(root.transfer_progress * 100) + "%";
                            font-size: 11px;
                            font-weight: 800;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 24px;
                            height: 22px;
                            border-radius: 5px;
                            background: cancel-m-btn.pressed ? #f43f5e44 : #1c263c;
                            border-width: 1px;
                            border-color: #f43f5e55;
                            cancel-m-btn := TouchArea {
                                clicked => { root.cancel_transfer_clicked(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 1.5px;
                                    background: Theme.status-error;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: #04060a;

                    Rectangle {
                        x: 0;
                        y: 0;
                        height: parent.height;
                        width: parent.width * root.transfer_progress;
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 100ms; easing: ease-out; }
                    }
                }
            }
        }

        // 3. مساحة العمل المركزية (حسب التبويب النشط)
        VerticalLayout {
            vertical-stretch: 1;

            // ================== الواجهة 0: البث المباشر والملاحظات (STREAM) ==================
            if root.active_tab_index == 0 : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: omni-m-input.has-focus ? Theme.border-focus : Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;
                    animate border-color { duration: 120ms; }

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "BEAM NOTE TO PC";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: Theme.text-primary;
                                    letter-spacing: 1px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    background: p-m-btn.pressed ? #1c263c : #0c121e;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: 6px;
                                    height: 24px;
                                    p-m-btn := TouchArea {
                                        clicked => { root.paste_to_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "PASTE";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Theme.text-secondary;
                                            letter-spacing: 0.5px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if root.draft_text != "" : Rectangle {
                                    background: #f43f5e22;
                                    border-radius: 6px;
                                    height: 24px;
                                    clr-m-btn := TouchArea {
                                        clicked => { root.clear_draft(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "CLEAR";
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: Theme.status-error;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // حقل الكتابة المباشر
                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            if root.draft_text == "" : Text {
                                text: "Type any note, message, link, code snippet or text to beam directly to PC...";
                                font-size: 12px;
                                color: Theme.text-faint;
                                wrap: word-wrap;
                                x: 10px;
                                y: 10px;
                                width: parent.width - 20px;
                            }

                            omni-m-input := TextInput {
                                text <=> root.draft_text;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: Theme.text-primary;
                                selection-background-color: #00d2ff44;
                                selection-foreground-color: #ffffff;
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                            }
                        }

                        // زر الإرسال الأساسي
                        Rectangle {
                            background: send-beam-m-btn.pressed ? #0284c7 : #0369a1;
                            border-width: 1px;
                            border-color: Theme.accent;
                            border-radius: Theme.radius-sm;
                            height: 38px;
                            animate background { duration: 120ms; }

                            send-beam-m-btn := TouchArea {
                                clicked => { root.send_custom_text(root.draft_text); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: root.text_sent ? "SENT TO PC" : "BEAM NOTE TO PC";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // الحافظة المستلمة من الحاسوب
                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 110px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "RECEIVED FROM PC";
                                font-size: 9px;
                                font-weight: 800;
                                color: Theme.text-muted;
                                letter-spacing: 1px;
                            }

                            Rectangle {
                                background: copy-m-btn.pressed ? #1c263c : #0c121e;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 5px;
                                height: 22px;
                                copy-m-btn := TouchArea {
                                    clicked => { root.copy_received_clicked(); }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: root.clipboard_copied ? "COPIED" : "COPY";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: root.clipboard_copied ? Theme.accent : Theme.text-secondary;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            vertical-stretch: 1;

                            Text {
                                text: root.last_received_text;
                                font-size: 11px;
                                color: root.last_received_text == "No text received yet" ? Theme.text-faint : Theme.text-primary;
                                wrap: word-wrap;
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                height: parent.height - 12px;
                            }
                        }
                    }
                }
            }

            // ================== الواجهة 1: مركز الملفات والمشاركة (FILES) ==================
            if root.active_tab_index == 1 : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 18px;
                        alignment: center;

                        Rectangle {
                            width: 60px;
                            height: 60px;
                            border-radius: 30px;
                            background: #00d2ff18;
                            border-width: 1px;
                            border-color: Theme.accent;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Rectangle {
                                    width: 2px;
                                    height: 16px;
                                    background: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                }
                                Rectangle {
                                    width: 12px;
                                    height: 2px;
                                    background: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Select & Beam Files";
                                font-size: 16px;
                                font-weight: 800;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Beam photos, documents, and downloads to PC";
                                font-size: 11px;
                                color: Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        // زر استعراض ملفات الهاتف
                        Rectangle {
                            width: 240px;
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            background: #0284c7;
                            border-width: 1px;
                            border-color: Theme.accent;
                            x: (parent.width - self.width) / 2;

                            browse-m-touch := TouchArea {
                                clicked => { root.share_file_clicked(); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.lang == "AR" ? "استعراض ملفات وذاكرة الجهاز" : "BROWSE DEVICE FILES";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // زر منتقي ملفات النظام الأصلي لأندرويد
                        Rectangle {
                            width: 240px;
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: Theme.surface-hover;
                            border-width: 1px;
                            border-color: Theme.border;
                            x: (parent.width - self.width) / 2;

                            saf-m-touch := TouchArea {
                                clicked => { root.open_system_picker_clicked(); }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.lang == "AR" ? "منتقي ملفات النظام الافتراضي (SAF)" : "SYSTEM FILE PICKER (SAF)";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.text-secondary;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // إجراءات سريعة إضافية
                        HorizontalLayout {
                            spacing: 8px;
                            width: 260px;
                            x: (parent.width - self.width) / 2;

                            Rectangle {
                                background: Theme.surface-hover;
                                border-width: 1px;
                                border-color: Theme.border;
                                border-radius: 6px;
                                height: 32px;
                                horizontal-stretch: 1;

                                push-clip-btn-m := TouchArea {
                                    clicked => { root.push_clipboard_clicked(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.clipboard_pushed ? "SENT CLIP" : "PUSH CLIPBOARD";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: root.clipboard_pushed ? Theme.accent : Theme.text-secondary;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: #0c121e;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                border-radius: 6px;
                                height: 32px;
                                horizontal-stretch: 1;

                                test-btn-m := TouchArea {
                                    clicked => { root.create_test_file(); }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "INSTANT TEST";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================== الواجهة 2: الشبكة والجهاز المتصل (MESH) ==================
            if root.active_tab_index == 2 : VerticalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                Rectangle {
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: root.is_connected ? #00d2ff44 : Theme.border;
                    border-radius: Theme.radius-md;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;
                        alignment: center;

                        Rectangle {
                            width: 60px;
                            height: 60px;
                            border-radius: 16px;
                            background: root.is_connected ? #00d2ff18 : Theme.recessed;
                            border-width: 1.5px;
                            border-color: root.is_connected ? Theme.accent : Theme.border-subtle;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 30px;
                                    height: 20px;
                                    border-radius: 3px;
                                    border-width: 1.5px;
                                    border-color: root.is_connected ? Theme.accent : Theme.text-muted;
                                    x: (parent.width - self.width) / 2;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.peer_name;
                                font-size: 16px;
                                font-weight: 800;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.is_connected ? "Zero-Hop Wi-Fi P2P Active" : "Scanning Wi-Fi...";
                                font-size: 11px;
                                color: root.is_connected ? Theme.accent : Theme.text-muted;
                                horizontal-alignment: center;
                            }
                        }

                        Rectangle {
                            background: Theme.recessed;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            width: 260px;
                            height: 80px;
                            x: (parent.width - self.width) / 2;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "SECURITY";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.text-muted;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: "ChaCha20-Poly1305";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.text-primary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "VERIFICATION";
                                        font-size: 9px;
                                        font-weight: 700;
                                        color: Theme.text-muted;
                                        letter-spacing: 1px;
                                    }
                                    Text {
                                        text: root.sas_code != "" ? "#" + root.sas_code + " Verified" : "Connecting...";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ================== الواجهة 3: سجل النشاطات للهاتف (ACTIVITY) ==================
            if root.active_tab_index == 3 : Rectangle {
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: Theme.radius-md;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "ACTIVITY HISTORY";
                            font-size: 10px;
                            font-weight: 800;
                            color: Theme.text-primary;
                            letter-spacing: 1px;
                        }

                        if root.history_items.length > 0 : Rectangle {
                            background: clr-m-hist.pressed ? #f43f5e33 : #0c121e;
                            border-radius: 4px;
                            height: 22px;
                            clr-m-hist := TouchArea {
                                clicked => { root.clear_history(); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "CLEAR";
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.status-error;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.history_items.length == 0 : VerticalLayout {
                        alignment: center;
                        vertical-stretch: 1;
                        spacing: 6px;
                        Text {
                            text: "No transfers yet in this session";
                            font-size: 12px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                    }

                    if root.history_items.length > 0 : ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.history_items : Rectangle {
                                background: Theme.recessed;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 44px;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    alignment: center;

                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 5px;
                                        background: item.kind == "file" ? #00d2ff18 : #6366f118;
                                        border-width: 1px;
                                        border-color: item.kind == "file" ? #00d2ff44 : #6366f144;
                                        y: (parent.height - self.height) / 2;

                                        Rectangle {
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: item.kind == "file" ? Theme.accent : #818cf8;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 1px;
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text {
                                            text: item.title;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.subtitle;
                                            font-size: 9px;
                                            color: Theme.text-muted;
                                        }
                                    }

                                    Text {
                                        text: item.timestamp;
                                        font-size: 9px;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // 4. الدوك السفلي للتنقل الانسيابي بين واجهات الهاتف (Thumb Dock)
        HorizontalLayout {
            alignment: center;
            height: 44px;

            Rectangle {
                background: #090e18f2;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 22px;
                height: 40px;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;
                    alignment: center;

                    // Tab 0: STREAM
                    Rectangle {
                        background: root.active_tab_index == 0 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 0 ? 1px : 0px;
                        border-color: root.active_tab_index == 0 ? Theme.border-focus : #00000000;
                        border-radius: 17px;
                        animate background { duration: 150ms; }
                        m-t0-touch := TouchArea {
                            clicked => { root.active_tab_index = 0; }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "STREAM";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active_tab_index == 0 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 1: FILES
                    Rectangle {
                        background: root.active_tab_index == 1 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 1 ? 1px : 0px;
                        border-color: root.active_tab_index == 1 ? Theme.border-focus : #00000000;
                        border-radius: 17px;
                        animate background { duration: 150ms; }
                        m-t1-touch := TouchArea {
                            clicked => { root.active_tab_index = 1; }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "FILES";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active_tab_index == 1 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 2: MESH
                    Rectangle {
                        background: root.active_tab_index == 2 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 2 ? 1px : 0px;
                        border-color: root.active_tab_index == 2 ? Theme.border-focus : #00000000;
                        border-radius: 17px;
                        animate background { duration: 150ms; }
                        m-t2-touch := TouchArea {
                            clicked => { root.active_tab_index = 2; }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: "MESH";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active_tab_index == 2 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tab 3: ACTIVITY
                    Rectangle {
                        background: root.active_tab_index == 3 ? #16243d : #00000000;
                        border-width: root.active_tab_index == 3 ? 1px : 0px;
                        border-color: root.active_tab_index == 3 ? Theme.border-focus : #00000000;
                        border-radius: 17px;
                        animate background { duration: 150ms; }
                        m-t3-touch := TouchArea {
                            clicked => { root.active_tab_index = 3; }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: root.history_items.length > 0 ? "ACTIVITY (" + root.history_items.length + ")" : "ACTIVITY";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.active_tab_index == 3 ? Theme.text-primary : Theme.text-muted;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // 5. نافذة اختيار واستعراض الملفات داخل التطبيق للهاتف (In-App File Browser Sheet)
    if root.show_file_picker : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #07090ef8;
        x: 0;
        y: 0;
        z: 100;

        VerticalLayout {
            padding-top: root.safe_area_top + 10px;
            padding-bottom: root.safe_area_bottom + 10px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "DEVICE STORAGE BROWSER";
                    font-size: 11px;
                    font-weight: 800;
                    color: Theme.text-primary;
                    letter-spacing: 1.2px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 6px;
                    background: close-fp-m.pressed ? #1c263c : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    close-fp-m := TouchArea {
                        clicked => { root.close_file_picker(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 1.5px;
                            background: Theme.text-secondary;
                            x: (parent.width - self.width) / 2;
                        }
                    }
                }
            }

            if root.picker_files.length == 0 : VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                spacing: 12px;
                Text {
                    text: "No files found in public storage";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Grant All Files Access in Android settings or create instant test file";
                    font-size: 11px;
                    color: Theme.text-faint;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 220px;
                    height: 38px;
                    border-radius: Theme.radius-sm;
                    background: #0284c7;
                    border-width: 1px;
                    border-color: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    create-test-btn := TouchArea {
                        clicked => { root.create_test_file(); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "CREATE & BEAM TEST FILE";
                            font-size: 10px;
                            font-weight: 800;
                            color: #ffffff;
                            letter-spacing: 0.8px;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 240px;
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: Theme.surface-hover;
                    border-width: 1px;
                    border-color: Theme.border;
                    x: (parent.width - self.width) / 2;
                    manage-perm-btn := TouchArea {
                        clicked => { root.open_storage_settings_clicked(); }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: root.lang == "AR" ? "تفعيل صلاحية الملفات في الإعدادات" : "STORAGE PERMISSION SETTINGS";
                            font-size: 9px;
                            font-weight: 800;
                            color: Theme.accent;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.picker_files.length > 0 : ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for f in root.picker_files : Rectangle {
                        background: fp-item-m.pressed ? #16243d : fp-item-m.has-hover ? #111a2c : Theme.surface;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 48px;

                        fp-item-m := TouchArea {
                            clicked => { root.file_selected(f.path); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            alignment: center;

                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 6px;
                                background: #00d2ff18;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                y: (parent.height - self.height) / 2;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: f.name;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: f.size_str;
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }

                            Rectangle {
                                width: 56px;
                                height: 26px;
                                border-radius: 6px;
                                background: #00d2ff18;
                                border-width: 1px;
                                border-color: #00d2ff44;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: "BEAM";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.accent;
                                        letter-spacing: 0.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
