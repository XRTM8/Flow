import { ScrollView } from "std-widgets.slint";
import { AppState } from "state.slint";
import { Theme } from "theme.slint";
import { FlowRow, FlowButton, BodyText, SmallText, SectionTitle, Separator, Panel, TextField } from "components.slint";

export component PairingPane inherits ScrollView {
    VerticalLayout {
        padding: AppState.mobile_mode ? 16px : 24px; spacing: 18px;
        FlowRow {
            SectionTitle { text: AppState.rtl ? "اقتران جهاز" : "Pair a device"; font-size: 21px; horizontal-stretch: 1; }
            FlowButton { text: AppState.rtl ? "رجوع" : "Back"; quiet: true; clicked => { AppState.show_pairing = false; } }
        }
        if AppState.selected_peer_id == "" : Panel {
            VerticalLayout {
                padding: 22px; spacing: 16px;
                BodyText { text: AppState.rtl ? "اختر الجهاز الذي تريد الاقتران به أولًا." : "Choose the device you want to pair with first."; }
                FlowButton { text: AppState.rtl ? "الأجهزة القريبة" : "Nearby devices"; primary: true; clicked => { AppState.show_pairing = false; AppState.show_devices = true; } }
            }
        }
        if AppState.selected_peer_id != "" : Panel {
            VerticalLayout {
                padding: 22px; spacing: 16px;
                FlowRow {
                    Image { source: @image-url("../assets/icons/monitor.svg"); width: 24px; height: 24px; colorize: Theme.secondary; }
                    BodyText { text: AppState.peer_name; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "تغيير" : "Change"; quiet: true; clicked => { AppState.show_pairing = false; AppState.show_devices = true; } }
                }
                Separator { }
                FlowRow {
                    BodyText { text: AppState.rtl ? "رمز هذا الجهاز" : "This device’s code"; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "نسخ" : "Copy"; icon: @image-url("../assets/icons/copy.svg"); quiet: true; enabled: AppState.pairing_code != ""; clicked => { AppState.copy_pairing_code(); } }
                }
                TextField { text: AppState.pairing_code; read_only: true; secret: true; label: AppState.rtl ? "رمز استقبال هذا الجهاز" : "This device’s receiving code"; min-height: 88px; }
                SmallText { text: AppState.rtl ? "الصقه في Flow على الجهاز الآخر. احتفظ بالرمز بين أجهزتك." : "Paste this into Flow on your other device. Keep the code between your devices."; }
                Separator { }
                FlowRow {
                    BodyText { text: AppState.rtl ? "رمز الجهاز الآخر" : "Other device’s code"; font-weight: 600; horizontal-stretch: 1; }
                    FlowButton { text: AppState.rtl ? "لصق" : "Paste"; quiet: true; enabled: !AppState.pairing_busy; clicked => { AppState.paste_pairing_code(); } }
                }
                TextField {
                    text <=> AppState.pair_secret; secret: true;
                    label: AppState.rtl ? "رمز الجهاز الآخر" : "Other device’s code";
                    placeholder: AppState.rtl ? "الصق الرمز الكامل هنا…" : "Paste the complete code here…";
                    min-height: 88px;
                }
                FlowButton {
                    text: AppState.pairing_busy ? (AppState.rtl ? "جارٍ الحفظ…" : "Saving…") : (AppState.rtl ? "حفظ الاقتران" : "Save pairing");
                    primary: true; horizontal-stretch: 1;
                    enabled: AppState.pair_secret != "" && !AppState.pairing_busy;
                    clicked => { AppState.pair_device(AppState.pair_secret); }
                }
                SmallText { text: AppState.rtl ? "أكمل تبادل الرمزين على الجهازين مرة واحدة." : "Complete the code exchange on both devices once."; }
            }
        }
    }
}

export component FileBrowser inherits Rectangle {
    VerticalLayout {
        padding: AppState.mobile_mode ? 16px : 24px; spacing: 14px;
        FlowRow {
            SectionTitle { text: AppState.browser_read_only ? (AppState.rtl ? "الملفات المستلمة" : "Received files") : (AppState.rtl ? "اختيار ملفات" : "Choose files"); font-size: 21px; horizontal-stretch: 1; }
            FlowButton { text: AppState.browser_read_only ? (AppState.rtl ? "إغلاق" : "Close") : (AppState.rtl ? "إلغاء" : "Cancel"); quiet: true; clicked => { AppState.close_file_browser(); } }
        }
        FlowRow {
            FlowButton { text: AppState.rtl ? "للأعلى" : "Up"; enabled: AppState.browser_can_up; clicked => { AppState.browse_up(); } }
            FlowButton { text: AppState.rtl ? "تحديث" : "Refresh"; icon: @image-url("../assets/icons/refresh.svg"); quiet: true; clicked => { AppState.browse_path(AppState.browser_path); } }
            if AppState.mobile_mode && !AppState.browser_read_only : FlowButton { text: AppState.rtl ? "الوصول" : "Access"; quiet: true; clicked => { AppState.request_storage_access(); } }
        }
        SmallText { text: AppState.browser_path; horizontal-alignment: left; wrap: no-wrap; overflow: elide; color: Theme.muted; }
        Panel {
            vertical-stretch: 1;
            ScrollView {
                VerticalLayout {
                    padding-left: 12px; padding-right: 12px;
                    if AppState.browser_items.length == 0 : VerticalLayout {
                        padding: 18px; spacing: 12px;
                        BodyText { text: AppState.rtl ? "لا توجد ملفات متاحة هنا." : "No accessible files here."; font-weight: 500; }
                        SmallText { text: AppState.browser_read_only ? (AppState.rtl ? "ستظهر الملفات التي تستلمها في هذا المجلد." : "Files you receive will appear in this folder.") : (AppState.rtl ? "اختر مجلدًا آخر. إذا لزم إذن للملفات، افتح الوصول ثم عد واضغط تحديث." : "Try another folder. If file access is needed, open Access, then return and refresh."); }
                    }
                    for entry in AppState.browser_items : Rectangle {
                        min-height: AppState.mobile_mode ? 82px : 72px;
                        background: entry.selected && !AppState.browser_read_only ? Theme.accent_soft : transparent;
                        border-radius: 8px;
                        FlowRow {
                            padding-left: 10px; padding-right: 10px;
                            Image { source: entry.is_dir ? @image-url("../assets/icons/folder.svg") : @image-url("../assets/icons/file-up.svg"); width: 21px; height: 21px; colorize: Theme.secondary; }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 3px;
                                BodyText { text: entry.name; font-weight: 500; overflow: elide; wrap: no-wrap; }
                                if entry.detail != "" : SmallText { text: entry.detail; overflow: elide; wrap: no-wrap; }
                            }
                            FlowButton {
                                text: entry.is_dir ? (AppState.rtl ? "فتح" : "Open") : AppState.browser_read_only ? (AppState.mobile_mode ? (AppState.rtl ? "حفظ نسخة" : "Save copy") : (AppState.rtl ? "فتح" : "Open")) : entry.selected ? (AppState.rtl ? "محدد" : "Selected") : (AppState.rtl ? "تحديد" : "Select");
                                selected: entry.selected && !AppState.browser_read_only;
                                quiet: !entry.selected || AppState.browser_read_only;
                                clicked => {
                                    if (entry.is_dir) { AppState.browse_path(entry.path); }
                                    else if (AppState.browser_read_only) { AppState.open_browser_file(entry.path); }
                                    else { AppState.toggle_file(entry.path); }
                                }
                            }
                        }
                        Separator { y: parent.height - 1px; }
                    }
                }
            }
        }
        if !AppState.browser_read_only : FlowRow {
            SmallText { text: AppState.rtl ? "إلى " + AppState.peer_name : "To " + AppState.peer_name; horizontal-stretch: 1; overflow: elide; wrap: no-wrap; }
            FlowButton {
                text: AppState.rtl ? "إرسال (" + AppState.browser_selection_count + ")" : "Send (" + AppState.browser_selection_count + ")";
                primary: true; enabled: AppState.browser_selection_count > 0 && AppState.is_connected && !AppState.busy;
                clicked => { AppState.send_selected_files(); }
            }
        }
    }
}
