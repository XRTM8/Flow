    in-out property <[TransferItem]> transfers: [];
    in-out property <[HistoryItem]> history_items: [];
    in-out property <string> notice: "";
    in-out property <bool> notice_error: false;
    in-out property <string> download_path: "";
    in-out property <string> pairing_code: "";
    in-out property <string> pair_secret: "";
    in-out property <bool> dark_mode: true;
    in-out property <bool> clean_links: true;
    in-out property <bool> auto_copy: false;
    in-out property <bool> show_history: false;
    in-out property <bool> show_settings: false;
    in-out property <bool> show_pairing: false;
    in-out property <bool> show_devices: false;
    in-out property <bool> pairing_busy: false;
    in-out property <bool> busy: false;
    in-out property <bool> update_available: false;
    in-out property <string> update_version: "";
    in-out property <bool> update_busy: false;
    in-out property <bool> update_blocked: false;
    in-out property <bool> update_waiting_confirmation: false;
    in-out property <string> update_status: "";
    in-out property <bool> update_error: false;
    in-out property <bool> show_file_picker: false;
    in-out property <bool> browser_read_only: false;
    in-out property <string> browser_path: "";
    in-out property <[FilePickerItem]> browser_items: [];
    in-out property <bool> browser_can_up: false;
    in-out property <int> browser_selection_count: 0;
    in-out property <length> safe_top: 0px;
