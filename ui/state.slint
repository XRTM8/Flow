    in-out property <bool> native_glass: false;
    in-out property <string> app_version: "2.4.3";
    in-out property <string> lang: "EN";
    out property <bool> rtl: lang == "AR";
    in-out property <[PeerItem]> peers: [];
    in-out property <[PeerItem]> trusted_devices: [];
    in-out property <string> selected_peer_id: "";
    in-out property <string> peer_name: "";
    in-out property <string> connection_status: "";
